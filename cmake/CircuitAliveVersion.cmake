# Match release_version.py: the KiCad base is followed by an independent
# CircuitAlive version, optionally prefixed with alpha.
function(circuitalive_parse_release_version version)
    if(NOT "${version}" MATCHES "^([0-9]+\\.[0-9]+\\.[0-9]+)-(alpha\\.)?([0-9]+(\\.[0-9]+)*)$")
        message(FATAL_ERROR "Expected KiCad-CircuitAlive version, e.g. 10.0.7-alpha.4.1 or 10.0.7-1.2.3")
    endif()
    set(base "${CMAKE_MATCH_1}")
    string(REPLACE "." ";" parts "${CMAKE_MATCH_3}")
    list(LENGTH parts count)
    if(count GREATER 4)
        message(FATAL_ERROR "CircuitAlive version accepts at most four numeric components")
    endif()
    set(numeric_parts "")
    foreach(part IN LISTS parts)
        if(part GREATER 65535)
            message(FATAL_ERROR "CircuitAlive version components must be between 0 and 65535")
        endif()
        string(REGEX REPLACE "^0+" "" part "${part}")
        if(part STREQUAL "")
            set(part 0)
        endif()
        list(APPEND numeric_parts "${part}")
    endforeach()
    while(count LESS 4)
        list(APPEND numeric_parts 0)
        math(EXPR count "${count} + 1")
    endwhile()
    list(JOIN numeric_parts ", " windows_version)
    set(CIRCUITALIVE_BASE_VERSION "${base}" PARENT_SCOPE)
    set(CIRCUITALIVE_WINDOWS_VERSION "${windows_version}" PARENT_SCOPE)
endfunction()
