{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "block_dff",
  "name": "DFF",
  "description": "Reusable event-driven digital block.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "data",
      "label": "Data",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "clock",
      "label": "Clock",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "set",
      "label": "Set",
      "role": "input",
      "default_pin": "3"
    },
    {
      "id": "reset",
      "label": "Reset",
      "role": "input",
      "default_pin": "4"
    },
    {
      "id": "q",
      "label": "Q",
      "role": "output",
      "default_pin": "5"
    },
    {
      "id": "nq",
      "label": "Nq",
      "role": "output",
      "default_pin": "6"
    },
    {
      "id": "vcc",
      "label": "Vcc",
      "role": "power",
      "default_pin": "7"
    },
    {
      "id": "gnd",
      "label": "Gnd",
      "role": "reference",
      "default_pin": "8"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Vil",
      "default": "0.3",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "Vih",
      "default": "0.7",
      "unit": "",
      "min": 0.1,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Vmin",
      "default": "2",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "vmax",
      "label": "Vmax",
      "default": "6",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "rise_delay",
      "label": "Rise delay",
      "default": "10n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "fall_delay",
      "label": "Fall delay",
      "default": "10n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Transition",
      "default": "2n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Rout",
      "default": "25",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "cin",
      "label": "Cin",
      "default": "3.5p",
      "unit": "F",
      "min": 0,
      "max": 1
    },
    {
      "id": "iq",
      "label": "Iq",
      "default": "2u",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "high_drop",
      "label": "High drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    },
    {
      "id": "low_drop",
      "label": "Low drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    }
  ],
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "dff",
        "data": "data",
        "clock": "clock",
        "set": "set",
        "reset": "reset",
        "q": "stored",
        "nq": "inverted",
        "initial": 2
      }
    ],
    "outputs": {
      "q": {
        "signal": "stored"
      },
      "nq": {
        "signal": "inverted"
      }
    }
  },
  "ignore_legacy_spice_fields": true,
  "category": "Building blocks",
  "family": "Analog and mixed signal"
}
