{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "ideal_enabled_buffer",
  "name": "Analog buffer with Enable / Hi-Z (ideal, no supply pins)",
  "description": "When Enable >= threshold, Y follows the analog voltage at A through Closed resistance. Otherwise Y is high impedance through Open resistance. The input is isolated from output load current. Output energy is ideal and supply current is not modeled. No supply pins are required. Signal and control voltages use circuit ground as reference.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "a",
      "label": "Analog input A",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "enable",
      "label": "Enable",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "y",
      "label": "Output Y",
      "role": "output",
      "default_pin": "3"
    }
  ],
  "parameters": [
    {
      "id": "threshold",
      "label": "Control threshold",
      "default": "2.5",
      "unit": "V",
      "min": -1000000.0,
      "max": 1000000.0
    },
    {
      "id": "on_resistance",
      "label": "Closed resistance",
      "default": "0.01",
      "unit": "Ohm",
      "min": 1e-09,
      "max": 1000000.0
    },
    {
      "id": "off_resistance",
      "label": "Open resistance",
      "default": "1e12",
      "unit": "Ohm",
      "min": 1,
      "max": 1000000000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Bsignal_${id} signal_${id} 0 V={v(${pin:a})}",
      "Ben_${id} enable_${id} 0 V={v(${pin:enable}) >= ${param:threshold} ? 1 : 0}",
      "Soutput_${id} signal_${id} ${pin:y} enable_${id} 0 switch_${id}",
      "Rinput_a_${id} ${pin:a} 0 1e12",
      "Rinput_enable_${id} ${pin:enable} 0 1e12"
    ],
    "definitions": [
      ".model switch_${id} SW(Ron=${param:on_resistance} Roff=${param:off_resistance} Vt=0.5 Vh=0)"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "category": "Building blocks/Ideal primitives",
  "family": "Ideal switches and routing"
}
