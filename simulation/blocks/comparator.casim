{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "comparator",
  "name": "Comparator",
  "description": "Reusable authoring block. Parameters and connections are embedded in the saved model.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "plus",
      "label": "Plus",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "minus",
      "label": "Minus",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "out",
      "label": "Out",
      "role": "output",
      "default_pin": "3"
    },
    {
      "id": "vcc",
      "label": "Vcc",
      "role": "power",
      "default_pin": "4"
    },
    {
      "id": "gnd",
      "label": "Gnd",
      "role": "reference",
      "default_pin": "5"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Vil",
      "default": "0.3",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "Vih",
      "default": "0.7",
      "unit": "",
      "min": 0.51,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Vmin",
      "default": "0.1",
      "unit": "V",
      "min": 0.01,
      "max": 100
    },
    {
      "id": "vmax",
      "label": "Vmax",
      "default": "40",
      "unit": "V",
      "min": 0.1,
      "max": 100
    },
    {
      "id": "response",
      "label": "Response",
      "default": "10n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Rout",
      "default": "25",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Ben_${id} en_${id} 0 V={v(${pin:vcc},${pin:gnd}) >= ${param:vmin} && v(${pin:vcc},${pin:gnd}) <= ${param:vmax}}",
      "Bcmp_${id} raw_${id} 0 V={v(${pin:plus},${pin:minus}) > 0}",
      "Rdelay_${id} raw_${id} code_${id} {${param:response}/1n}",
      "Cdelay_${id} code_${id} 0 1n",
      "Bhi_${id} ${pin:out} ${pin:vcc} I={v(en_${id}) > .5 ? v(code_${id})*v(${pin:out},${pin:vcc})/${param:rout} : 0}",
      "Blo_${id} ${pin:out} ${pin:gnd} I={v(en_${id}) > .5 ? (1-v(code_${id}))*v(${pin:out},${pin:gnd})/${param:rout} : 0}"
    ],
    "definitions": []
  },
  "ignore_legacy_spice_fields": true,
  "logic": {
    "vcc": "vcc",
    "gnd": "gnd",
    "low_parameter": "vil",
    "high_parameter": "vih",
    "min_supply_parameter": "vmin",
    "max_supply_parameter": "vmax",
    "driver_enable": {
      "out": "v(en_${id})"
    },
    "driver_value": {
      "out": "v(code_${id})"
    }
  },
  "category": "Building blocks",
  "family": "Analog and mixed signal"
}
