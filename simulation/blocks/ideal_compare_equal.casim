{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "ideal_compare_equal",
  "name": "COMPARE A = B (tolerance) (ideal, no supply pins)",
  "description": "Y = HIGH when A = B (tolerance); otherwise LOW. Equality uses the absolute voltage difference and the configured tolerance. Output energy is ideal and supply current is not modeled. No supply pins are required. Signal and control voltages use circuit ground as reference.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "a",
      "label": "Input A",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "b",
      "label": "Input B",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "y",
      "label": "Output Y",
      "role": "output",
      "default_pin": "3"
    }
  ],
  "parameters": [
    {
      "id": "tolerance",
      "label": "Equality tolerance",
      "default": "1m",
      "unit": "V",
      "min": 0,
      "max": 1000000.0
    },
    {
      "id": "high",
      "label": "HIGH output level",
      "default": "5",
      "unit": "V",
      "min": -1000000.0,
      "max": 1000000.0
    },
    {
      "id": "low",
      "label": "LOW output level",
      "default": "0",
      "unit": "V",
      "min": -1000000.0,
      "max": 1000000.0
    },
    {
      "id": "rout",
      "label": "Output resistance",
      "default": "1",
      "unit": "Ohm",
      "min": 1e-06,
      "max": 1000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Bresult_${id} result_${id} 0 V={(abs(v(${pin:a},${pin:b})) <= ${param:tolerance}) ? ${param:high} : ${param:low}}",
      "Rout_${id} result_${id} ${pin:y} ${param:rout}",
      "Rinput_a_${id} ${pin:a} 0 1e12",
      "Rinput_b_${id} ${pin:b} 0 1e12"
    ],
    "definitions": []
  },
  "ignore_legacy_spice_fields": true,
  "category": "Building blocks/Ideal primitives",
  "family": "Ideal logic and conditions"
}
