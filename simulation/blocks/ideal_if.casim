{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "ideal_if",
  "name": "IF / ELSE (ideal analog values, no supply pins)",
  "description": "IF Condition >= threshold THEN Y follows the voltage at A ELSE Y follows B. This actively drives a voltage through Output resistance; it does not disconnect the output or join input wires. Input voltages may be analog. Output energy is ideal and supply current is not modeled. No supply pins are required. Signal and control voltages use circuit ground as reference.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "a",
      "label": "Value if TRUE (A)",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "b",
      "label": "Value if FALSE (B)",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "condition",
      "label": "Condition",
      "role": "input",
      "default_pin": "3"
    },
    {
      "id": "y",
      "label": "Output Y",
      "role": "output",
      "default_pin": "4"
    }
  ],
  "parameters": [
    {
      "id": "threshold",
      "label": "Control threshold",
      "default": "2.5",
      "unit": "V",
      "min": -1000000.0,
      "max": 1000000.0
    },
    {
      "id": "rout",
      "label": "Output resistance",
      "default": "1",
      "unit": "Ohm",
      "min": 1e-06,
      "max": 1000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Bresult_${id} result_${id} 0 V={v(${pin:condition}) >= ${param:threshold} ? v(${pin:a}) : v(${pin:b})}",
      "Rout_${id} result_${id} ${pin:y} ${param:rout}",
      "Rinput_a_${id} ${pin:a} 0 1e12",
      "Rinput_b_${id} ${pin:b} 0 1e12",
      "Rinput_condition_${id} ${pin:condition} 0 1e12"
    ],
    "definitions": []
  },
  "ignore_legacy_spice_fields": true,
  "category": "Building blocks/Ideal primitives",
  "family": "Ideal switches and routing"
}
