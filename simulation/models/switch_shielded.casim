{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "switch_shielded",
  "name": "Shielded push button",
  "description": "Interactive contact topology; generic configurable contacts, not a manufacturer-certified model.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "p",
      "label": "P",
      "role": "passive",
      "default_pin": "1"
    },
    {
      "id": "n",
      "label": "N",
      "role": "passive",
      "default_pin": "2"
    },
    {
      "id": "shield",
      "label": "Shield",
      "role": "passive",
      "default_pin": "SH"
    }
  ],
  "parameters": [
    {
      "id": "on_resistance",
      "label": "Closed resistance",
      "default": "0.01",
      "unit": "Ohm",
      "min": 1e-09,
      "max": 1000000.0
    },
    {
      "id": "off_resistance",
      "label": "Open resistance",
      "default": "1e12",
      "unit": "Ohm",
      "min": 1,
      "max": 1000000000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Vcontrol${id} control${id} 0 ${control:initial}",
      "S${id} ${pin:p} ${pin:n} control${id} 0 m${id}",
      "Rshield_${id} ${pin:shield} 0 1e12"
    ],
    "definitions": [
      ".model m${id} SW(Ron=${param:on_resistance} Roff=${param:off_resistance} Vt=2.5 Vh=0.1)"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "category": "Electromechanical/Switches",
  "family": "Interactive switches",
  "model_notes": [
    "Generic contact combination using the existing switch primitive; finite Ron/Roff, no contact bounce or manufacturer-specific timing/current rating.",
    "Pin pairs and common terminals were reviewed from the bundled standard symbol drawings. All physical pins are represented.",
    "Shield is independent of the switched contact; only a 1 TOhm numerical leakage to ground is used."
  ],
  "matches": {
    "library_ids": [
      "Switch:CK_KMS2xxG",
      "Switch:CK_KMS2xxGP",
      "Switch:SW_Push_Shielded"
    ],
    "symbol_names": [
      "CK_KMS2xxG",
      "CK_KMS2xxGP",
      "SW_Push_Shielded"
    ]
  },
  "control": {
    "source": "Vcontrol${id}",
    "on": 5,
    "off": 0,
    "initially_closed": false
  },
  "measurement_ports": {
    "positive": "p",
    "negative": "n"
  }
}
