  "ignore_legacy_spice_fields": true,
  "matches": {
    "library_ids": [
      "74xx:74HC00"
    ],
    "symbol_names": [
      "74HC00"
    ]
  },
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  },
  "category": "Digital/Logic ICs",
  "family": "74HC",
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "nand",
        "inputs": [
          "a1",
          "b1"
        ],
        "out": "q1"
      },
      {
        "type": "nand",
        "inputs": [
          "a2",
          "b2"
        ],
        "out": "q2"
      },
      {
        "type": "nand",
        "inputs": [
          "a3",
          "b3"
        ],
        "out": "q3"
      },
      {
        "type": "nand",
        "inputs": [
          "a4",
          "b4"
        ],
        "out": "q4"
      }
    ],
    "outputs": {
      "y1": {
        "signal": "q1"
      },
      "y2": {
        "signal": "q2"
      },
      "y3": {
        "signal": "q3"
      },
      "y4": {
        "signal": "q4"
      }
    },
    "electrical": {
      "input_low_current": "iil",
      "input_high_current": "iih",
      "output_high_resistance": "rout_high",
      "output_low_resistance": "rout_low",
      "source_rating": "ioh",
      "sink_rating": "iol",
      "switching_capacitance": "cpd",
      "current_rating_window": "rating_window"
    }
  },
  "sources": [
    "https://assets.nexperia.com/documents/data-sheet/74HC_HCT00.pdf"
  ],
  "model_notes": [
    "Own behavioral implementation, calibrated to selected datasheet points; no vendor SPICE copied.",
    "Finite asymmetric output resistance, input DC current/capacitance, per-output source/sink current warnings and powered propagation delays are represented.",
    "Output current ratings trigger warnings, not artificial hard current clamps. No transistor-level short-circuit or protection model.",
    "Delay, drive strength and consumption use nominal values near the stated reference supply; full supply-dependent timing/drive curves, damage, input clamp/back-powering and temperature are outside this model. Inputs without an external driver remain unknown.",
    "Reference: 4.5\u20135 V. HC input thresholds track supply (0.3/0.7 VCC). Input leakage uses a configurable conservative signed 100 nA load, not a complete protection I/V.",
    "45/37.5 ohm source/sink resistances fit typical VOH=4.32 V, VOL=0.15 V at 4 mA and VCC=4.5 V. The 4 mA warnings are reference operating limits, not hard limits valid at every supply.",
    "IQ=1 uA is an illustrative static nominal value; CPD=22 pF per switching input implements internal dynamic ICC=CPD*VCC*f. External capacitive load energy is additionally supplied by the physical output stage.",
    "7 ns internal gate delay and 2 ns code transition plus output RC approximate nominal timing; no separate hard frequency cutoff is invented.",
    "Per-output current warnings use a first-order 1 us averaging window for DC operating ratings; normal short capacitive charging peaks are not instantaneous overload limits."
  ]
}
