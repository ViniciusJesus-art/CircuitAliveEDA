{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74hc00",
  "name": "74HC00 quad NAND (powered, mixed-signal)",
  "description": "Modelo didático configurável; não é um macromodelo certificado pelo fabricante.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "a1",
      "label": "A1",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "b1",
      "label": "B1",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "y1",
      "label": "Y1",
      "role": "output",
      "default_pin": "3"
    },
    {
      "id": "a2",
      "label": "A2",
      "role": "input",
      "default_pin": "4"
    },
    {
      "id": "b2",
      "label": "B2",
      "role": "input",
      "default_pin": "5"
    },
    {
      "id": "y2",
      "label": "Y2",
      "role": "output",
      "default_pin": "6"
    },
    {
      "id": "gnd",
      "label": "GND",
      "role": "reference",
      "default_pin": "7"
    },
    {
      "id": "y3",
      "label": "Y3",
      "role": "output",
      "default_pin": "8"
    },
    {
      "id": "a3",
      "label": "A3",
      "role": "input",
      "default_pin": "9"
    },
    {
      "id": "b3",
      "label": "B3",
      "role": "input",
      "default_pin": "10"
    },
    {
      "id": "y4",
      "label": "Y4",
      "role": "output",
      "default_pin": "11"
    },
    {
      "id": "a4",
      "label": "A4",
      "role": "input",
      "default_pin": "12"
    },
    {
      "id": "b4",
      "label": "B4",
      "role": "input",
      "default_pin": "13"
    },
    {
      "id": "vcc",
      "label": "VCC",
      "role": "power",
      "default_pin": "14"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Low input threshold / VCC",
      "default": "0.3",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "High input threshold / VCC",
      "default": "0.7",
      "unit": "",
      "min": 0.51,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Minimum supply voltage",
      "default": "2",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "vmax",
      "label": "Maximum supply voltage",
      "default": "6",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "rise_delay",
      "label": "Low-to-high propagation delay",
      "default": "7n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "fall_delay",
      "label": "High-to-low propagation delay",
      "default": "7n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Output transition time",
      "default": "2n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Output resistance (nominal)",
      "default": "25",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "cin",
      "label": "Input capacitance",
      "default": "3.5p",
      "unit": "F",
      "min": 0,
      "max": 1
    }
  ],
  "spice": {
    "instance": [
      "Ben_${id} en_${id} 0 V={(v(${pin:vcc},${pin:gnd}) >= ${param:vmin} && v(${pin:vcc},${pin:gnd}) <= ${param:vmax})}",
      "Bn_a1_${id} n_a1_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:a1} > 0.5) ? v(${pin:a1},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_a1_${id} ${pin:a1} ${pin:gnd} ${param:cin}",
      "Bn_b1_${id} n_b1_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:b1} > 0.5) ? v(${pin:b1},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_b1_${id} ${pin:b1} ${pin:gnd} ${param:cin}",
      "Aadc1_${id} [n_a1_${id} n_b1_${id}] [d_a1_${id} d_b1_${id}] adc_${id}",
      "Ag1_${id} [d_a1_${id} d_b1_${id}] d_y1_${id} gate_${id}",
      "Adac1_${id} [d_y1_${id}] [code1_${id}] dac_${id}",
      "Bhi1_${id} ${pin:y1} ${pin:vcc} I={v(en_${id}) > 0.5 ? ((v(code1_${id}) > ${param:vih} || v(code1_${id}) < ${param:vil}) ? 1 : 1u)*v(code1_${id})*v(${pin:y1},${pin:vcc})/${param:rout} : 0}",
      "Blo1_${id} ${pin:y1} ${pin:gnd} I={v(en_${id}) > 0.5 ? ((v(code1_${id}) > ${param:vih} || v(code1_${id}) < ${param:vil}) ? 1 : 1u)*(1-v(code1_${id}))*v(${pin:y1},${pin:gnd})/${param:rout} : 0}",
      "Bn_a2_${id} n_a2_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:a2} > 0.5) ? v(${pin:a2},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_a2_${id} ${pin:a2} ${pin:gnd} ${param:cin}",
      "Bn_b2_${id} n_b2_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:b2} > 0.5) ? v(${pin:b2},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_b2_${id} ${pin:b2} ${pin:gnd} ${param:cin}",
      "Aadc2_${id} [n_a2_${id} n_b2_${id}] [d_a2_${id} d_b2_${id}] adc_${id}",
      "Ag2_${id} [d_a2_${id} d_b2_${id}] d_y2_${id} gate_${id}",
      "Adac2_${id} [d_y2_${id}] [code2_${id}] dac_${id}",
      "Bhi2_${id} ${pin:y2} ${pin:vcc} I={v(en_${id}) > 0.5 ? ((v(code2_${id}) > ${param:vih} || v(code2_${id}) < ${param:vil}) ? 1 : 1u)*v(code2_${id})*v(${pin:y2},${pin:vcc})/${param:rout} : 0}",
      "Blo2_${id} ${pin:y2} ${pin:gnd} I={v(en_${id}) > 0.5 ? ((v(code2_${id}) > ${param:vih} || v(code2_${id}) < ${param:vil}) ? 1 : 1u)*(1-v(code2_${id}))*v(${pin:y2},${pin:gnd})/${param:rout} : 0}",
      "Bn_a3_${id} n_a3_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:a3} > 0.5) ? v(${pin:a3},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_a3_${id} ${pin:a3} ${pin:gnd} ${param:cin}",
      "Bn_b3_${id} n_b3_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:b3} > 0.5) ? v(${pin:b3},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_b3_${id} ${pin:b3} ${pin:gnd} ${param:cin}",
      "Aadc3_${id} [n_a3_${id} n_b3_${id}] [d_a3_${id} d_b3_${id}] adc_${id}",
      "Ag3_${id} [d_a3_${id} d_b3_${id}] d_y3_${id} gate_${id}",
      "Adac3_${id} [d_y3_${id}] [code3_${id}] dac_${id}",
      "Bhi3_${id} ${pin:y3} ${pin:vcc} I={v(en_${id}) > 0.5 ? ((v(code3_${id}) > ${param:vih} || v(code3_${id}) < ${param:vil}) ? 1 : 1u)*v(code3_${id})*v(${pin:y3},${pin:vcc})/${param:rout} : 0}",
      "Blo3_${id} ${pin:y3} ${pin:gnd} I={v(en_${id}) > 0.5 ? ((v(code3_${id}) > ${param:vih} || v(code3_${id}) < ${param:vil}) ? 1 : 1u)*(1-v(code3_${id}))*v(${pin:y3},${pin:gnd})/${param:rout} : 0}",
      "Bn_a4_${id} n_a4_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:a4} > 0.5) ? v(${pin:a4},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_a4_${id} ${pin:a4} ${pin:gnd} ${param:cin}",
      "Bn_b4_${id} n_b4_${id} 0 V={(v(en_${id}) > 0.5 && ${drive:b4} > 0.5) ? v(${pin:b4},${pin:gnd})/max(v(${pin:vcc},${pin:gnd}),1u) : 0.5}",
      "Cin_b4_${id} ${pin:b4} ${pin:gnd} ${param:cin}",
      "Aadc4_${id} [n_a4_${id} n_b4_${id}] [d_a4_${id} d_b4_${id}] adc_${id}",
      "Ag4_${id} [d_a4_${id} d_b4_${id}] d_y4_${id} gate_${id}",
      "Adac4_${id} [d_y4_${id}] [code4_${id}] dac_${id}",
      "Bhi4_${id} ${pin:y4} ${pin:vcc} I={v(en_${id}) > 0.5 ? ((v(code4_${id}) > ${param:vih} || v(code4_${id}) < ${param:vil}) ? 1 : 1u)*v(code4_${id})*v(${pin:y4},${pin:vcc})/${param:rout} : 0}",
      "Blo4_${id} ${pin:y4} ${pin:gnd} I={v(en_${id}) > 0.5 ? ((v(code4_${id}) > ${param:vih} || v(code4_${id}) < ${param:vil}) ? 1 : 1u)*(1-v(code4_${id}))*v(${pin:y4},${pin:gnd})/${param:rout} : 0}"
    ],
    "definitions": [
      ".model adc_${id} adc_bridge(in_low=${param:vil} in_high=${param:vih})",
      ".model gate_${id} d_nand(rise_delay=${param:rise_delay} fall_delay=${param:fall_delay})",
      ".model dac_${id} dac_bridge(out_low=0 out_high=1 out_undef=0.5 t_rise=${param:transition} t_fall=${param:transition})"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "matches": {
    "library_ids": [
      "74xx:74HC00"
    ],
    "symbol_names": [
      "74HC00"
    ]
  },
  "logic": {
    "vcc": "vcc",
    "gnd": "gnd",
    "low_parameter": "vil",
    "high_parameter": "vih",
    "min_supply_parameter": "vmin",
    "max_supply_parameter": "vmax",
    "driver_enable": {
      "y1": "v(en_${id})",
      "y2": "v(en_${id})",
      "y3": "v(en_${id})",
      "y4": "v(en_${id})"
    },
    "driver_value": {
      "y1": "v(code1_${id})",
      "y2": "v(code2_${id})",
      "y3": "v(code3_${id})",
      "y4": "v(code4_${id})"
    }
  },
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  },
  "category": "Digital/Logic ICs",
  "family": "74HC"
}
