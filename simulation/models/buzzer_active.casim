{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "buzzer_active",
  "name": "Active buzzer \u2014 internal oscillator",
  "description": "An internally driven buzzer. A valid DC supply enables its tone; choose the passive buzzer for externally generated audio.",
  "license": "GPL-3.0-or-later",
  "category": "Simulation outputs",
  "family": "Functional peripherals",
  "pins": [
    {
      "id": "p",
      "label": "Positive",
      "role": "power",
      "default_pin": "1"
    },
    {
      "id": "n",
      "label": "Negative",
      "role": "reference",
      "default_pin": "2"
    }
  ],
  "parameters": [
    {
      "id": "frequency",
      "label": "Internal tone frequency",
      "default": "2000",
      "unit": "Hz",
      "min": 20,
      "max": 20000
    },
    {
      "id": "supply_min",
      "label": "Minimum supply",
      "default": "2.5",
      "unit": "V",
      "min": 0.1,
      "max": 100
    },
    {
      "id": "supply_max",
      "label": "Maximum supply",
      "default": "5.5",
      "unit": "V",
      "min": 0.1,
      "max": 100
    },
    {
      "id": "current",
      "label": "Operating current",
      "default": ".02",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "volume",
      "label": "Playback volume",
      "default": "0.2",
      "unit": "",
      "min": 0,
      "max": 1
    }
  ],
  "spice": {
    "instance": [
      "Bload_${id} ${pin:p} ${pin:n} I={v(${pin:p},${pin:n})>=${param:supply_min} && v(${pin:p},${pin:n})<=${param:supply_max} ? ${param:current} : 0}",
      "Baudio_${id} audio_${id} 0 V={v(${pin:p},${pin:n})>=${param:supply_min} && v(${pin:p},${pin:n})<=${param:supply_max} ? sin(6.283185307179586*${param:frequency}*time) : 0}"
    ],
    "definitions": []
  },
  "audio": {
    "signal": "v(audio_${id})",
    "full_scale": 1,
    "volume_parameter": "volume"
  },
  "matches": {
    "library_ids": [
      "CircuitAlive_Simulation:Buzzer_Active"
    ]
  }
}
