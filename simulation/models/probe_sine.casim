{
  "schema_version": 1,
  "backend": "ngspice",
  "license": "GPL-3.0-or-later",
  "category": "Sources/Debug probes",
  "family": "Ground-referenced stimulus probes",
  "pins": [
    {
      "id": "out",
      "label": "Output",
      "role": "output",
      "default_pin": "1"
    },
    {
      "id": "gnd",
      "label": "Internal GND",
      "role": "reference",
      "default_pin": "2"
    }
  ],
  "reference_pin": "gnd",
  "measurement_ports": {
    "positive": "out",
    "negative": "gnd"
  },
  "matches": {
    "library_ids": [],
    "symbol_names": []
  },
  "current_warning": {
    "signal": "i(Vsense${id})",
    "limit_parameter": "current_warning"
  },
  "id": "probe_sine",
  "name": "Sine stimulus probe",
  "description": "Ground-referenced sine generator. Amplitude is peak voltage; offset, frequency, delay, phase and output resistance are configurable.",
  "parameters": [
    {
      "id": "resistance",
      "label": "Output resistance",
      "default": "1",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "current_warning",
      "label": "Current warning (0 disables)",
      "default": "1",
      "unit": "A",
      "min": 0,
      "max": 1000000.0
    },
    {
      "id": "frequency",
      "label": "Frequency",
      "default": "1000",
      "unit": "Hz",
      "min": 0.001,
      "max": 10000000.0
    },
    {
      "id": "delay",
      "label": "Start delay",
      "default": "0",
      "unit": "s",
      "min": 0,
      "max": 3600
    },
    {
      "id": "amplitude",
      "label": "Peak amplitude",
      "default": "2.5",
      "unit": "V",
      "min": 0,
      "max": 1000000.0
    },
    {
      "id": "offset",
      "label": "DC offset",
      "default": "2.5",
      "unit": "V",
      "min": -1000000.0,
      "max": 1000000.0
    },
    {
      "id": "phase",
      "label": "Phase",
      "default": "0",
      "unit": "deg",
      "min": -360,
      "max": 360
    }
  ],
  "frequency_parameter": "frequency",
  "spice": {
    "instance": [
      "Vwave${id} drive${id} ${pin:gnd} SIN(${param:offset} ${param:amplitude} ${param:frequency} ${param:delay} 0 ${param:phase})",
      "Rout${id} drive${id} sense${id} ${param:resistance}",
      "Vsense${id} sense${id} ${pin:out} 0"
    ],
    "definitions": []
  }
}
