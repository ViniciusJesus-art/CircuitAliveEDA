    "blocks": [
      {
        "type": "nand",
        "inputs": [
          "i1_0",
          "i1_1"
        ],
        "out": "q1"
      },
      {
        "type": "nand",
        "inputs": [
          "i2_0",
          "i2_1"
        ],
        "out": "q2"
      },
      {
        "type": "nand",
        "inputs": [
          "i3_0",
          "i3_1"
        ],
        "out": "q3"
      },
      {
        "type": "nand",
        "inputs": [
          "i4_0",
          "i4_1"
        ],
        "out": "q4"
      }
    ],
