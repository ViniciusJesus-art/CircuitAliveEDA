      "y1": {
        "signal": "q1"
      },
      "y2": {
        "signal": "q2"
      },
      "y3": {
        "signal": "q3"
      },
      "y4": {
        "signal": "q4"
      }
    },
    "electrical": {
      "input_low_current": "iil",
      "input_high_current": "iih",
      "output_high_resistance": "rout_high",
      "output_low_resistance": "rout_low",
      "source_rating": "ioh",
      "sink_rating": "iol",
      "threshold_reference": "vref",
      "input_low_reference": "iil_ref",
