{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "inductor",
  "name": "Ideal inductor",
  "description": "Stores magnetic energy. Its voltage depends on how quickly the current changes.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "p",
      "label": "Terminal 1",
      "role": "passive",
      "default_pin": "1"
    },
    {
      "id": "n",
      "label": "Terminal 2",
      "role": "passive",
      "default_pin": "2"
    }
  ],
  "parameters": [
    {
      "id": "inductance",
      "label": "Inductance",
      "default": "$value",
      "unit": "H",
      "min": 1e-12,
      "max": 1000000.0
    }
  ],
  "spice": {
    "instance": [
      "L${id} ${pin:p} ${pin:n} ${param:inductance} IC=0"
    ],
    "definitions": []
  },
  "ignore_legacy_spice_fields": true,
  "matches": {
    "library_ids": [
      "Device:L",
      "Device:L_45deg",
      "Device:L_Ferrite",
      "Device:L_Ferrite_Small",
      "Device:L_Iron",
      "Device:L_Iron_Small",
      "Device:L_Polarized",
      "Device:L_Small",
      "Device:L_Trim"
    ],
    "symbol_names": [
      "L",
      "L_45deg",
      "L_Ferrite",
      "L_Ferrite_Small",
      "L_Iron",
      "L_Iron_Small",
      "L_Polarized",
      "L_Small",
      "L_Trim"
    ]
  },
  "measurement_ports": {
    "positive": "p",
    "negative": "n"
  },
  "category": "Analog/Passive components",
  "family": "Inductors",
  "legacy_parameters": {
    "map": {
      "l": "inductance"
    },
    "only_if_value_invalid": true
  },
  "equations": [
    "V1 − V2 = L × dI/dt."
  ],
  "model_notes": [
    "Core/trim/rotated variants use the configured linear inductance and winding resistance. Core saturation, hysteresis and adjustment mechanisms are not simulated."
  ]
}
