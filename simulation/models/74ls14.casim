      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "inverter",
        "inputs": [
          "i1_0"
        ],
        "out": "q1"
      },
      {
        "type": "inverter",
        "inputs": [
          "i2_0"
        ],
        "out": "q2"
      },
      {
        "type": "inverter",
        "inputs": [
          "i3_0"
        ],
        "out": "q3"
      },
      {
        "type": "inverter",
        "inputs": [
          "i4_0"
        ],
        "out": "q4"
      },
      {
        "type": "inverter",
        "inputs": [
          "i5_0"
        ],
        "out": "q5"
      },
      {
        "type": "inverter",
        "inputs": [
          "i6_0"
        ],
        "out": "q6"
      }
    ],
    "outputs": {
      "y1": {
        "signal": "q1"
      },
      "y2": {
        "signal": "q2"
      },
      "y3": {
        "signal": "q3"
      },
      "y4": {
        "signal": "q4"
      },
      "y5": {
        "signal": "q5"
      },
      "y6": {
        "signal": "q6"
      }
    },
    "input_hysteresis": true,
    "electrical": {
      "input_low_current": "iil",
      "input_high_current": "iih",
      "output_high_resistance": "rout_high",
      "output_low_resistance": "rout_low",
      "source_rating": "ioh",
      "sink_rating": "iol",
      "threshold_reference": "vref",
      "input_low_reference": "iil_ref",
      "input_high_reference": "iih_ref",
      "quiescent_low": "iq_low",
      "current_rating_window": "rating_window"
    }
  },
  "sources": [
    "https://www.ti.com/lit/ds/symlink/sn74ls14.pdf"
  ],
  "model_notes": [
    "Own behavioral implementation, calibrated to selected datasheet points; no vendor SPICE copied.",
    "Finite asymmetric output resistance, input DC current/capacitance, per-output source/sink current warnings and powered propagation delays are represented.",
    "Output current ratings trigger warnings, not artificial hard current clamps. No transistor-level short-circuit or protection model.",
    "Delay, drive strength and consumption use nominal values near the stated reference supply; full supply-dependent timing/drive curves, damage, input clamp/back-powering and temperature are outside this model. Inputs without an external driver remain unknown.",
    "Reference: 5 V. Absolute typical Schmitt thresholds VT+=1.6 V and VT-=0.8 V; fixed throughout 4.75\u20135.25 V.",
    "TTL signed input load: -0.4 mA at 0.4 V, +20 uA at 2.7 V; simplified linear interpolation between reference points. Output warnings at 0.4/8 mA; nominal ICC HIGH/LOW=8.6/12 mA, interpolated across six outputs.",
    "15 ns internal propagation delay per edge, plus 2 ns transition and load RC. Internal dynamic TTL supply current and continuous analog transfer in the hysteresis region are not represented.",
    "Schmitt inputs retain the last valid level between thresholds; initial in-band inputs are unknown. Loss of supply or external drive invalidates the retained input state.",
    "Per-output current warnings use a first-order 1 us averaging window for DC operating ratings; normal short capacitive charging peaks are not instantaneous overload limits."
  ],
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  },
  "category": "Digital/Logic ICs",
  "family": "74LS"
}
