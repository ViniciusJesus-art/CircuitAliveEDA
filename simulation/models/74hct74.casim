{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74hct74",
  "name": "74HCT74 dual D flip-flop",
  "description": "Room-temperature mixed-signal functional approximation with finite output resistance and propagation delay. See docs/circuitalive/MODEL_CATALOG.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "vcc",
      "label": "vcc",
      "role": "power",
      "default_pin": "14"
    },
    {
      "id": "gnd",
      "label": "gnd",
      "role": "reference",
      "default_pin": "7"
    },
    {
      "id": "d1",
      "label": "d1",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "clk1",
      "label": "clk1",
      "role": "input",
      "default_pin": "3"
    },
    {
      "id": "pre1",
      "label": "pre1",
      "role": "input",
      "default_pin": "4"
    },
    {
      "id": "clr1",
      "label": "clr1",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "q1",
      "label": "q1",
      "role": "output",
      "default_pin": "5"
    },
    {
      "id": "nq1",
      "label": "nq1",
      "role": "output",
      "default_pin": "6"
    },
    {
      "id": "d2",
      "label": "d2",
      "role": "input",
      "default_pin": "12"
    },
    {
      "id": "clk2",
      "label": "clk2",
      "role": "input",
      "default_pin": "11"
    },
    {
      "id": "pre2",
      "label": "pre2",
      "role": "input",
      "default_pin": "10"
    },
    {
      "id": "clr2",
      "label": "clr2",
      "role": "input",
      "default_pin": "13"
    },
    {
      "id": "q2",
      "label": "q2",
      "role": "output",
      "default_pin": "9"
    },
    {
      "id": "nq2",
      "label": "nq2",
      "role": "output",
      "default_pin": "8"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Vil",
      "default": ".16",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "Vih",
      "default": ".4",
      "unit": "",
      "min": 0.1,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Vmin",
      "default": "4.5",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "vmax",
      "label": "Vmax",
      "default": "5.5",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "rise_delay",
      "label": "Rise delay",
      "default": "15n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "fall_delay",
      "label": "Fall delay",
      "default": "15n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Transition",
      "default": "3n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Rout",
      "default": "35",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "cin",
      "label": "Cin",
      "default": "3.5p",
      "unit": "F",
      "min": 0,
      "max": 1
    },
    {
      "id": "iq",
      "label": "Iq",
      "default": "2u",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "high_drop",
      "label": "High drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    },
    {
      "id": "low_drop",
      "label": "Low drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    }
  ],
  "matches": {
    "library_ids": [
      "74xx:74HCT74"
    ],
    "symbol_names": [
      "74HCT74"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "dff",
        "data": "d1",
        "clock": "clk1",
        "set": "!pre1",
        "reset": "!clr1",
        "q": "s1",
        "nq": "ns1",
        "initial": 2
      },
      {
        "type": "dff",
        "data": "d2",
        "clock": "clk2",
        "set": "!pre2",
        "reset": "!clr2",
        "q": "s2",
        "nq": "ns2",
        "initial": 2
      }
    ],
    "outputs": {
      "q1": {
        "signal": "s1"
      },
      "nq1": {
        "signal": "ns1"
      },
      "q2": {
        "signal": "s2"
      },
      "nq2": {
        "signal": "ns2"
      }
    },
    "clock_hysteresis": true
  },
  "sources": [
    "https://www.ti.com/lit/ds/symlink/sn74hct74.pdf",
    "https://assets.nexperia.com/documents/data-sheet/74HC_HCT74.pdf"
  ],
  "model_notes": [
    "Own behavioral implementation; no vendor SPICE source copied.",
    "Truth table, physical pinout, supply operating range, input thresholds and approximate delay are represented.",
    "Propagation delay, output resistance and quiescent current are fixed nominal parameters near 5V/room temperature, not complete supply/temperature/load curves.",
    "No thermal damage, ESD/back-powering, short-circuit protection or setup/hold violation checking. Floating inputs remain unknown.",
    "TTL input thresholds are normalized to nominal 5V (0.8V/2V); they scale slightly with supply in this approximation. DC TTL input currents/fan-out are not modeled.",
    "Clock inputs use supply-relative Schmitt action (vil/vih) so a dip into the threshold band cannot clock the next stage twice. Data and asynchronous control pins retain 0/X/1 input behavior. Thresholds are a compact nominal approximation, not exact Schmitt curves."
  ],
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  },
  "category": "Digital/Logic ICs",
  "family": "74HCT"
}
