  ],
  "model_notes": [
    "Own behavioral implementation; no vendor SPICE source copied.",
    "Truth table, physical pinout, supply operating range, input thresholds and approximate delay are represented.",
    "Propagation delay, output resistance and quiescent current are fixed nominal parameters near 5V/room temperature, not complete supply/temperature/load curves.",
    "No thermal damage, ESD/back-powering, short-circuit protection or setup/hold violation checking. Floating inputs remain unknown.",
    "TTL input thresholds are normalized to nominal 5V (0.8V/2V); they scale slightly with supply in this approximation. DC TTL input currents/fan-out are not modeled."
  ],
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  },
  "category": "Digital/Logic ICs",
  "family": "74LS"
}
