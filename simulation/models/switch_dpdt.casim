{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "switch_dpdt",
  "name": "Two ganged SPDT contacts",
  "description": "Interactive contact topology; generic configurable contacts, not a manufacturer-certified model.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "terminal1",
      "label": "Terminal1",
      "role": "passive",
      "default_pin": "1"
    },
    {
      "id": "terminal2",
      "label": "Terminal2",
      "role": "passive",
      "default_pin": "2"
    },
    {
      "id": "terminal3",
      "label": "Terminal3",
      "role": "passive",
      "default_pin": "3"
    },
    {
      "id": "terminal4",
      "label": "Terminal4",
      "role": "passive",
      "default_pin": "4"
    },
    {
      "id": "terminal5",
      "label": "Terminal5",
      "role": "passive",
      "default_pin": "5"
    },
    {
      "id": "terminal6",
      "label": "Terminal6",
      "role": "passive",
      "default_pin": "6"
    }
  ],
  "parameters": [
    {
      "id": "on_resistance",
      "label": "Closed resistance",
      "default": "0.01",
      "unit": "Ohm",
      "min": 1e-09,
      "max": 1000000.0
    },
    {
      "id": "off_resistance",
      "label": "Open resistance",
      "default": "1e12",
      "unit": "Ohm",
      "min": 1,
      "max": 1000000000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Vcontrol${id} control${id} 0 ${control:initial}",
      "Brest_${id} rest_${id} 0 V={5-v(control${id})}",
      "Srest2_${id} ${pin:terminal2} ${pin:terminal1} rest_${id} 0 m${id}",
      "Sother2_${id} ${pin:terminal2} ${pin:terminal3} control${id} 0 m${id}",
      "Srest5_${id} ${pin:terminal5} ${pin:terminal4} rest_${id} 0 m${id}",
      "Sother5_${id} ${pin:terminal5} ${pin:terminal6} control${id} 0 m${id}"
    ],
    "definitions": [
      ".model m${id} SW(Ron=${param:on_resistance} Roff=${param:off_resistance} Vt=2.5 Vh=0.1)"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "category": "Electromechanical/Switches",
  "family": "Interactive switches",
  "model_notes": [
    "Generic contact combination using the existing switch primitive; finite Ron/Roff, no contact bounce or manufacturer-specific timing/current rating.",
    "Pin pairs and common terminals were reviewed from the bundled standard symbol drawings. All physical pins are represented."
  ],
  "matches": {
    "library_ids": [
      "Switch:SW_DPDT_x2",
      "Switch:SW_Push_DPDT",
      "Switch:SW_Slide_DPDT"
    ],
    "symbol_names": [
      "SW_DPDT_x2",
      "SW_Push_DPDT",
      "SW_Slide_DPDT"
    ]
  },
  "control": {
    "source": "Vcontrol${id}",
    "on": 5,
    "off": 0,
    "initially_closed": false
  }
}
