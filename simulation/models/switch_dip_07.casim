{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "switch_dip_07",
  "name": "7-position DIP switch",
  "description": "Interactive contact topology; generic configurable contacts, not a manufacturer-certified model.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "terminal1",
      "label": "Terminal1",
      "role": "passive",
      "default_pin": "1"
    },
    {
      "id": "terminal2",
      "label": "Terminal2",
      "role": "passive",
      "default_pin": "2"
    },
