    },
    {
      "id": "terminal13",
      "label": "Terminal13",
      "role": "passive",
      "default_pin": "13"
    },
    {
      "id": "terminal14",
      "label": "Terminal14",
      "role": "passive",
      "default_pin": "14"
    }
  ],
  "parameters": [
    {
      "id": "on_resistance",
      "label": "Closed resistance",
      "default": "0.01",
      "unit": "Ohm",
      "min": 1e-09,
      "max": 1000000.0
    },
    {
      "id": "off_resistance",
      "label": "Open resistance",
      "default": "1e12",
      "unit": "Ohm",
      "min": 1,
      "max": 1000000000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Vcontrol1_${id} control1_${id} 0 0",
      "Schannel1_${id} ${pin:terminal1} ${pin:terminal14} control1_${id} 0 m${id}",
      "Vcontrol2_${id} control2_${id} 0 0",
      "Schannel2_${id} ${pin:terminal2} ${pin:terminal13} control2_${id} 0 m${id}",
      "Vcontrol3_${id} control3_${id} 0 0",
      "Schannel3_${id} ${pin:terminal3} ${pin:terminal12} control3_${id} 0 m${id}",
      "Vcontrol4_${id} control4_${id} 0 0",
      "Schannel4_${id} ${pin:terminal4} ${pin:terminal11} control4_${id} 0 m${id}",
      "Vcontrol5_${id} control5_${id} 0 0",
      "Schannel5_${id} ${pin:terminal5} ${pin:terminal10} control5_${id} 0 m${id}",
      "Vcontrol6_${id} control6_${id} 0 0",
      "Schannel6_${id} ${pin:terminal6} ${pin:terminal9} control6_${id} 0 m${id}",
      "Vcontrol7_${id} control7_${id} 0 0",
      "Schannel7_${id} ${pin:terminal7} ${pin:terminal8} control7_${id} 0 m${id}"
    ],
    "definitions": [
      ".model m${id} SW(Ron=${param:on_resistance} Roff=${param:off_resistance} Vt=2.5 Vh=0.1)"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "category": "Electromechanical/Switches",
  "family": "Interactive switches",
  "model_notes": [
    "Generic contact combination using the existing switch primitive; finite Ron/Roff, no contact bounce or manufacturer-specific timing/current rating.",
    "Pin pairs and common terminals were reviewed from the bundled standard symbol drawings. All physical pins are represented.",
    "Each pole has an independent interactive control. Contact i pairs with physical pin 2*N+1-i."
  ],
  "matches": {
    "library_ids": [
      "Switch:SW_DIP_x07"
    ],
    "symbol_names": [
      "SW_DIP_x07"
    ]
  },
