{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "bjt_bd140",
  "name": "BD140 PNP transistor",
  "description": "Room-temperature compact approximation calibrated against datasheet operating points. See docs/circuitalive/DISCRETE_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "c",
      "label": "Collector",
      "default_pin": "2",
      "role": "passive"
    },
    {
      "id": "b",
      "label": "Base",
      "default_pin": "3",
      "role": "input"
    },
    {
      "id": "e",
      "label": "Emitter",
      "default_pin": "1",
      "role": "reference"
    }
  ],
  "parameters": [
    {
      "id": "beta",
      "label": "Low-current forward gain",
      "default": "110",
      "unit": "",
      "min": 1,
      "max": 2000
    },
    {
      "id": "saturation_current",
      "label": "Transport saturation current",
      "default": "200f",
      "unit": "A",
      "min": 1e-20,
      "max": 0.001
    },
    {
      "id": "knee_current",
      "label": "High-current gain roll-off",
      "default": "0.6",
      "unit": "A",
      "min": 1e-06,
      "max": 100
    },
    {
      "id": "early_voltage",
      "label": "Early voltage",
      "default": "50",
      "unit": "V",
      "min": 1,
      "max": 10000.0
    },
    {
      "id": "base_resistance",
      "label": "Base spreading resistance",
      "default": "8",
      "unit": "Ohm",
      "min": 0,
      "max": 10000.0
    },
    {
      "id": "collector_resistance",
      "label": "Collector lead resistance",
      "default": "0.12",
      "unit": "Ohm",
      "min": 0,
      "max": 100
    },
    {
      "id": "emitter_resistance",
      "label": "Emitter lead resistance",
      "default": "0.05",
      "unit": "Ohm",
      "min": 0,
      "max": 100
    },
    {
      "id": "base_capacitance",
      "label": "Zero-bias base-emitter capacitance",
      "default": "120p",
      "unit": "F",
      "min": 0,
      "max": 0.001
    },
    {
      "id": "collector_capacitance",
      "label": "Zero-bias collector-base capacitance",
      "default": "35p",
      "unit": "F",
      "min": 0,
      "max": 0.001
    },
    {
      "id": "transit_time",
      "label": "Forward transit time",
      "default": "1n",
      "unit": "s",
      "min": 0,
      "max": 1
    },
    {
      "id": "storage_time",
      "label": "Reverse transit / saturation storage parameter",
      "default": "250n",
      "unit": "s",
      "min": 0,
      "max": 1
    },
    {
      "id": "current_warning",
      "label": "Collector current warning (not a current limiter)",
      "default": "1.5",
      "unit": "A",
      "min": 0,
      "max": 100
    }
  ],
  "spice": {
    "instance": [
      "Vcollector_${id} ${pin:c} collector_${id} 0",
      "Q${id} collector_${id} ${pin:b} ${pin:e} transistor_${id}"
    ],
    "definitions": [
      ".model transistor_${id} PNP(Is=${param:saturation_current} Bf=${param:beta} Ikf=${param:knee_current} Vaf=${param:early_voltage} Rb=${param:base_resistance} Rc=${param:collector_resistance} Re=${param:emitter_resistance} Br=4 Cje=${param:base_capacitance} Cjc=${param:collector_capacitance} Vje=0.75 Vjc=0.75 Mje=0.33 Mjc=0.33 Tf=${param:transit_time} Tr=${param:storage_time})",
      ".options method=gear maxord=2"
    ]
  },
  "matches": {
    "library_ids": [
      "Transistor_BJT:BD140"
    ],
    "part_names": [
      "BD140",
      "QBD140"
    ],
    "pin_names": {
      "b": [
        "B"
      ],
      "c": [
        "C"
      ],
      "e": [
        "E"
      ]
    },
    "symbol_names": [
      "BD140"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "measurement_ports": {
    "positive": "c",
    "negative": "e"
  },
  "sources": [
    "https://www.st.com/resource/en/datasheet/bd139.pdf"
  ],
  "model_notes": [
    "Fitted electrical approximation, not copied vendor SPICE code.",
    "No destructive breakdown, SOA or thermal self-heating. Current rating reports an overload, without clamping it.",
    "Physical pins follow the installed KiCad symbol, including E-B-C for PN2222A.",
    "Requests circuit-wide Gear order 2 integration to damp numerical charge-storage ringing, without imposing a small maximum timestep."
  ],
  "current_warning": {
    "signal": "i(Vcollector_${id})",
    "limit_parameter": "current_warning"
  },
  "category": "Semiconductors/Transistors",
  "family": "Bipolar"
}
