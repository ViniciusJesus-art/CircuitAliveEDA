{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "l7805",
  "name": "7805 fixed regulator",
  "description": "Configurable behavioral approximation; see docs/circuitalive/COMPLEX_MODELS.md for fidelity and limits.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "in",
      "label": "in",
      "role": "power",
      "default_pin": "1"
    },
    {
      "id": "out",
      "label": "out",
      "role": "output",
      "default_pin": "3"
    },
    {
      "id": "gnd",
      "label": "gnd",
      "role": "reference",
      "default_pin": "2"
    }
  ],
  "parameters": [
    {
      "id": "vout",
      "label": "Vout",
      "default": "5",
      "unit": "V",
      "min": 0.1,
      "max": 40
    },
    {
      "id": "dropout",
      "label": "Dropout",
      "default": "2",
      "unit": "V",
      "min": 0,
      "max": 10
    },
    {
      "id": "imax",
      "label": "Imax",
      "default": "1.5",
      "unit": "A",
      "min": 1e-06,
      "max": 10
    },
    {
      "id": "rout",
      "label": "Rout",
      "default": "0.05",
      "unit": "Ohm",
      "min": 0.001,
      "max": 1000
    },
    {
      "id": "response",
      "label": "Response",
      "default": "5u",
      "unit": "s",
      "min": 1e-09,
      "max": 1
    },
    {
      "id": "iq",
      "label": "Iq",
      "default": "5m",
      "unit": "A",
      "min": 0,
      "max": 1
    }
  ],
  "matches": {
    "library_ids": [
      "Regulator_Linear:L7805"
    ],
    "symbol_names": [
      "L7805"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "spice": {
    "instance": [
      "Btarget_${id} target_${id} 0 V={max(0,min(${param:vout},v(${pin:in},${pin:gnd})-${param:dropout}))}",
      "Rresponse_${id} target_${id} response_${id} {${param:response}/1n}",
      "Cresponse_${id} response_${id} 0 1n ic=0",
      "Bpass_${id} ${pin:in} ${pin:out} I={v(${pin:in},${pin:gnd}) > 0 ? max(0,min(${param:imax},(v(response_${id})-v(${pin:out},${pin:gnd}))/${param:rout})) : 0}",
      "Biq_${id} ${pin:in} ${pin:gnd} I={v(${pin:in},${pin:gnd}) > 0 ? ${param:iq} : 0}"
    ]
  },
  "measurement_ports": {
    "positive": "in",
    "negative": "gnd"
  },
  "category": "Power/Linear regulators",
  "family": "LM78xx"
}
