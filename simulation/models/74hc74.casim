{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74hc74",
  "name": "74HC74 dual D flip-flop",
  "description": "Configurable behavioral approximation; see docs/circuitalive/COMPLEX_MODELS.md for fidelity and limits.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "vcc",
      "label": "vcc",
      "role": "power",
      "default_pin": "14"
    },
    {
      "id": "gnd",
      "label": "gnd",
      "role": "reference",
      "default_pin": "7"
    },
    {
      "id": "d1",
      "label": "d1",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "clk1",
      "label": "clk1",
      "role": "input",
      "default_pin": "3"
    },
    {
      "id": "pre1",
      "label": "pre1",
      "role": "input",
      "default_pin": "4"
    },
    {
      "id": "clr1",
      "label": "clr1",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "q1",
      "label": "q1",
      "role": "output",
      "default_pin": "5"
    },
    {
      "id": "nq1",
      "label": "nq1",
      "role": "output",
      "default_pin": "6"
    },
    {
      "id": "d2",
      "label": "d2",
      "role": "input",
      "default_pin": "12"
    },
    {
      "id": "clk2",
      "label": "clk2",
      "role": "input",
      "default_pin": "11"
    },
    {
      "id": "pre2",
      "label": "pre2",
      "role": "input",
      "default_pin": "10"
    },
    {
      "id": "clr2",
      "label": "clr2",
      "role": "input",
      "default_pin": "13"
    },
    {
      "id": "q2",
      "label": "q2",
      "role": "output",
      "default_pin": "9"
    },
    {
      "id": "nq2",
      "label": "nq2",
      "role": "output",
      "default_pin": "8"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Vil",
      "default": "0.3",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "Vih",
      "default": "0.7",
      "unit": "",
      "min": 0.1,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Vmin",
      "default": "2",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "vmax",
      "label": "Vmax",
      "default": "6",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "rise_delay",
      "label": "Rise delay",
      "default": "10n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "fall_delay",
      "label": "Fall delay",
      "default": "10n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Transition",
      "default": "2n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Rout",
      "default": "25",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "cin",
      "label": "Cin",
      "default": "3.5p",
      "unit": "F",
      "min": 0,
      "max": 1
    },
    {
      "id": "iq",
      "label": "Iq",
      "default": "2u",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "high_drop",
      "label": "High drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    },
    {
      "id": "low_drop",
      "label": "Low drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    }
  ],
  "matches": {
    "library_ids": [
      "74xx:74HC74"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "dff",
        "data": "d1",
        "clock": "clk1",
        "set": "!pre1",
        "reset": "!clr1",
        "q": "s1",
        "nq": "ns1",
        "initial": 2
      },
      {
        "type": "dff",
        "data": "d2",
        "clock": "clk2",
        "set": "!pre2",
        "reset": "!clr2",
        "q": "s2",
        "nq": "ns2",
        "initial": 2
      }
    ],
    "outputs": {
      "q1": {
        "signal": "s1"
      },
      "nq1": {
        "signal": "ns1"
      },
      "q2": {
        "signal": "s2"
      },
      "nq2": {
        "signal": "ns2"
      }
    }
  }
}
