{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "mosfet_bs170",
  "name": "BS170 N-channel MOSFET",
  "description": "Room-temperature compact approximation calibrated against datasheet operating points. See docs/circuitalive/DISCRETE_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "d",
      "label": "Drain",
      "default_pin": "1",
      "role": "passive"
    },
    {
      "id": "g",
      "label": "Gate",
      "default_pin": "2",
      "role": "input"
    },
    {
      "id": "s",
      "label": "Source",
      "default_pin": "3",
      "role": "reference"
    }
  ],
  "parameters": [
    {
      "id": "threshold",
      "label": "Channel threshold (not the fully-on gate voltage)",
      "default": "2",
      "unit": "V",
      "min": 0.1,
      "max": 10
    },
    {
      "id": "transconductance",
      "label": "Channel transconductance factor",
      "default": "0.25",
      "unit": "A/V2",
      "min": 1e-05,
      "max": 10000.0
    },
    {
      "id": "drain_resistance",
      "label": "Drain series resistance",
      "default": "0.55",
      "unit": "Ohm",
      "min": 1e-05,
      "max": 10000.0
    },
    {
      "id": "source_resistance",
      "label": "Source series resistance",
      "default": "0.55",
      "unit": "Ohm",
      "min": 1e-05,
      "max": 10000.0
    },
    {
      "id": "gate_resistance",
      "label": "Internal gate resistance",
      "default": "2",
      "unit": "Ohm",
      "min": 0.01,
      "max": 10000.0
    },
    {
      "id": "gate_source_capacitance",
      "label": "Gate-source capacitance",
      "default": "35p",
      "unit": "F",
      "min": 1e-15,
      "max": 0.001
    },
    {
      "id": "miller_min",
      "label": "Gate-drain capacitance at positive Vds",
      "default": "4p",
      "unit": "F",
      "min": 1e-15,
      "max": 0.001
    },
    {
      "id": "miller_max",
      "label": "Gate-drain capacitance near reverse conduction",
      "default": "16p",
      "unit": "F",
      "min": 1e-15,
      "max": 0.001
    },
    {
      "id": "body_capacitance",
      "label": "Zero-bias body junction capacitance",
      "default": "70p",
      "unit": "F",
      "min": 1e-15,
      "max": 0.001
    },
    {
      "id": "body_transit",
      "label": "Body diode reverse transit parameter",
      "default": "10n",
      "unit": "s",
      "min": 0,
      "max": 1
    },
    {
      "id": "breakdown",
      "label": "Drain-source avalanche voltage",
      "default": "60",
      "unit": "V",
      "min": 1,
      "max": 10000.0
    },
    {
      "id": "current_warning",
      "label": "Drain current warning (not a current limiter)",
      "default": "0.5",
      "unit": "A",
      "min": 0,
      "max": 1000.0
    }
  ],
  "spice": {
    "instance": [
      "Vdrain_${id} ${pin:d} drain_${id} 0",
      "M${id} drain_${id} ${pin:g} ${pin:s} mosfet_${id}",
      "Rgate_leak_${id} ${pin:g} ${pin:s} 1e12"
    ],
    "definitions": [
      ".model mosfet_${id} VDMOS(Vto=${param:threshold} Kp=${param:transconductance} Lambda=0.002 Rd=${param:drain_resistance} Rs=${param:source_resistance} Rg=${param:gate_resistance} Cgs=${param:gate_source_capacitance} Cgdmin=${param:miller_min} Cgdmax=${param:miller_max} A=0.3 Cjo=${param:body_capacitance} M=0.5 Vj=0.8 Is=10n N=1.2 Rb=0.05 Bv=${param:breakdown} Ibv=250u Tt=${param:body_transit} Rds=1e10)"
    ]
  },
  "matches": {
    "library_ids": [
      "Transistor_FET:BS170"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "measurement_ports": {
    "positive": "d",
    "negative": "s"
  },
  "sources": [
    "https://www.onsemi.com/download/data-sheet/pdf/bs170-d.pdf",
    "https://ngspice.sourceforge.io/docs/ngspice-manual.pdf"
  ],
  "model_notes": [
    "One native compact VDMOS, no transistor-level cell array or thermal network.",
    "Gate threshold and on-resistance are different quantities; IRF540N is characterized for a 10V gate.",
    "Capacitances and reverse recovery approximate selected operating points, not full datasheet curves."
  ],
  "current_warning": {
    "signal": "i(Vdrain_${id})",
    "limit_parameter": "current_warning"
  }
}
