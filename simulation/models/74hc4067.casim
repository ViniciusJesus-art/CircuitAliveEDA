{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74hc4067",
  "name": "CD74HC4067 analog multiplexer",
  "description": "Nominal 25 C bilateral analog routing; finite supply-dependent resistance and control delays. See docs/circuitalive/ROUTING_PROTECTION_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "vcc",
      "label": "Positive supply",
      "default_pin": "24",
      "role": "power"
    },
    {
      "id": "gnd",
      "label": "Logic reference / lower supply",
      "default_pin": "12",
      "role": "reference"
    },
    {
      "id": "s0",
      "label": "Address 0",
      "default_pin": "10",
      "role": "input"
    },
    {
      "id": "s1",
      "label": "Address 1",
      "default_pin": "11",
      "role": "input"
    },
    {
      "id": "s2",
      "label": "Address 2",
      "default_pin": "14",
      "role": "input"
    },
    {
      "id": "s3",
      "label": "Address 3",
      "default_pin": "13",
      "role": "input"
    },
    {
      "id": "inh",
      "label": "Inhibit (HIGH disables)",
      "default_pin": "15",
      "role": "input"
    },
    {
      "id": "com0",
      "label": "Common 0",
      "default_pin": "1",
      "role": "passive"
    },
    {
      "id": "ch0_0",
      "label": "Channel 0.0",
      "default_pin": "9",
      "role": "passive"
    },
    {
      "id": "ch0_1",
      "label": "Channel 0.1",
      "default_pin": "8",
      "role": "passive"
    },
    {
      "id": "ch0_2",
      "label": "Channel 0.2",
      "default_pin": "7",
      "role": "passive"
    },
    {
      "id": "ch0_3",
      "label": "Channel 0.3",
      "default_pin": "6",
      "role": "passive"
    },
    {
      "id": "ch0_4",
      "label": "Channel 0.4",
      "default_pin": "5",
      "role": "passive"
    },
    {
      "id": "ch0_5",
      "label": "Channel 0.5",
      "default_pin": "4",
      "role": "passive"
    },
    {
      "id": "ch0_6",
      "label": "Channel 0.6",
      "default_pin": "3",
      "role": "passive"
    },
    {
      "id": "ch0_7",
      "label": "Channel 0.7",
      "default_pin": "2",
      "role": "passive"
    },
    {
      "id": "ch0_8",
      "label": "Channel 0.8",
      "default_pin": "23",
      "role": "passive"
    },
    {
      "id": "ch0_9",
      "label": "Channel 0.9",
      "default_pin": "22",
      "role": "passive"
    },
    {
      "id": "ch0_10",
      "label": "Channel 0.10",
      "default_pin": "21",
      "role": "passive"
    },
    {
      "id": "ch0_11",
      "label": "Channel 0.11",
      "default_pin": "20",
      "role": "passive"
    },
    {
      "id": "ch0_12",
      "label": "Channel 0.12",
      "default_pin": "19",
      "role": "passive"
    },
    {
      "id": "ch0_13",
      "label": "Channel 0.13",
      "default_pin": "18",
      "role": "passive"
    },
    {
      "id": "ch0_14",
      "label": "Channel 0.14",
      "default_pin": "17",
      "role": "passive"
    },
    {
      "id": "ch0_15",
      "label": "Channel 0.15",
      "default_pin": "16",
      "role": "passive"
    }
  ],
  "parameters": [
    {
      "id": "ron_low",
      "label": "On resistance at 4.5 V",
      "default": "70",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000.0
    },
    {
      "id": "ron_mid",
      "label": "On resistance at 6 V",
      "default": "60",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000.0
    },
    {
      "id": "ron_high",
      "label": "On resistance at 9 V",
      "default": "60",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000.0
    },
    {
      "id": "roff",
      "label": "Off resistance per channel",
      "default": "1e12",
      "unit": "Ohm",
      "min": 1000.0,
      "max": 1000000000000000.0
    },
    {
      "id": "vil",
      "label": "LOW threshold / logic supply",
      "default": "0.3",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "HIGH threshold / logic supply",
      "default": "0.7",
      "unit": "",
      "min": 0.5,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Minimum logic supply",
      "default": "2",
      "unit": "V",
      "min": 0.1,
      "max": 30
    },
    {
      "id": "vmax",
      "label": "Maximum logic supply",
      "default": "6",
      "unit": "V",
      "min": 0.1,
      "max": 30
    },
    {
      "id": "analog_max",
      "label": "Maximum total analog supply span",
      "default": "6",
      "unit": "V",
      "min": 0.1,
      "max": 30
    },
    {
      "id": "turn_on",
      "label": "Channel turn-on delay",
      "default": "50n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "turn_off",
      "label": "Channel turn-off delay",
      "default": "20n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Control transition time",
      "default": "2n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "cin",
      "label": "Control pin capacitance",
      "default": "5p",
      "unit": "F",
      "min": 0,
      "max": 1e-06
    },
    {
      "id": "cport",
      "label": "Analog port capacitance",
      "default": "5p",
      "unit": "F",
      "min": 0,
      "max": 1e-06
    },
    {
      "id": "iq",
      "label": "Package quiescent current",
      "default": "1u",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "warning_current",
      "label": "Channel current warning",
      "default": "10m",
      "unit": "A",
      "min": 0,
      "max": 1
    }
  ],
  "matches": {
    "library_ids": [
      "74xx:CD74HC4067M",
      "74xx:CD74HC4067SM"
    ],
    "symbol_names": [
      "CD74HC4067M",
      "CD74HC4067SM"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "spice": {
    "instance": [
      "Bpower_${id} power_${id} 0 V={v(${pin:vcc},${pin:gnd}) >= ${param:vmin} && v(${pin:vcc},${pin:gnd}) <= ${param:vmax} && v(${pin:vcc},${pin:gnd}) <= ${param:analog_max}}",
      "Biq_${id} ${pin:vcc} ${pin:gnd} I={v(power_${id}) > .5 ? ${param:iq} : 0}",
      "Rlo_s0_${id} ${pin:s0} ${pin:gnd} 1e12",
      "Cin_s0_${id} ${pin:s0} ${pin:gnd} ${param:cin}",
      "Rlo_s1_${id} ${pin:s1} ${pin:gnd} 1e12",
      "Cin_s1_${id} ${pin:s1} ${pin:gnd} ${param:cin}",
      "Rlo_s2_${id} ${pin:s2} ${pin:gnd} 1e12",
      "Cin_s2_${id} ${pin:s2} ${pin:gnd} ${param:cin}",
      "Rlo_s3_${id} ${pin:s3} ${pin:gnd} 1e12",
      "Cin_s3_${id} ${pin:s3} ${pin:gnd} ${param:cin}",
      "Rlo_inh_${id} ${pin:inh} ${pin:gnd} 1e12",
      "Cin_inh_${id} ${pin:inh} ${pin:gnd} ${param:cin}",
      "Cp_com0_${id} ${pin:com0} ${pin:gnd} ${param:cport}",
      "Cp_ch0_0_${id} ${pin:ch0_0} ${pin:gnd} ${param:cport}",
      "Cp_ch0_1_${id} ${pin:ch0_1} ${pin:gnd} ${param:cport}",
      "Cp_ch0_2_${id} ${pin:ch0_2} ${pin:gnd} ${param:cport}",
      "Cp_ch0_3_${id} ${pin:ch0_3} ${pin:gnd} ${param:cport}",
      "Cp_ch0_4_${id} ${pin:ch0_4} ${pin:gnd} ${param:cport}",
      "Cp_ch0_5_${id} ${pin:ch0_5} ${pin:gnd} ${param:cport}",
      "Cp_ch0_6_${id} ${pin:ch0_6} ${pin:gnd} ${param:cport}",
      "Cp_ch0_7_${id} ${pin:ch0_7} ${pin:gnd} ${param:cport}",
      "Cp_ch0_8_${id} ${pin:ch0_8} ${pin:gnd} ${param:cport}",
      "Cp_ch0_9_${id} ${pin:ch0_9} ${pin:gnd} ${param:cport}",
      "Cp_ch0_10_${id} ${pin:ch0_10} ${pin:gnd} ${param:cport}",
      "Cp_ch0_11_${id} ${pin:ch0_11} ${pin:gnd} ${param:cport}",
      "Cp_ch0_12_${id} ${pin:ch0_12} ${pin:gnd} ${param:cport}",
      "Cp_ch0_13_${id} ${pin:ch0_13} ${pin:gnd} ${param:cport}",
      "Cp_ch0_14_${id} ${pin:ch0_14} ${pin:gnd} ${param:cport}",
      "Cp_ch0_15_${id} ${pin:ch0_15} ${pin:gnd} ${param:cport}",
      "Bselect0_${id} select0_${id} 0 V={v(power_${id}) > .5 && ${drive:s0} > .5 && ${drive:s1} > .5 && ${drive:s2} > .5 && ${drive:s3} > .5 && ${drive:inh} > .5 && v(${pin:inh},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s0},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s1},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s2},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s3},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) ? 1 : 0}",
      "Aadc0_${id} [select0_${id}] [raw0_${id}] adc_${id}",
      "Adelay0_${id} raw0_${id} delayed0_${id} delay_${id}",
      "Adac0_${id} [delayed0_${id}] [state0_${id}] dac_${id}",
      "Vsense0_${id} ${pin:com0} contact0_${id} 0",
      "Bpath0_${id} contact0_${id} ${pin:ch0_0} I={v(contact0_${id},${pin:ch0_0})*(1/${param:roff}+(v(power_${id}) > .5 ? max(0,min(1,2*v(state0_${id})-1)) : 0)*(1/(v(${pin:vcc},${pin:gnd}) <= 4.5 ? ${param:ron_low} : v(${pin:vcc},${pin:gnd}) <= 6 ? ${param:ron_low}+(${param:ron_mid}-${param:ron_low})*(v(${pin:vcc},${pin:gnd})-4.5)/1.5 : v(${pin:vcc},${pin:gnd}) < 9 ? ${param:ron_mid}+(${param:ron_high}-${param:ron_mid})*(v(${pin:vcc},${pin:gnd})-6)/3 : ${param:ron_high})-1/${param:roff}))}",
      "Bselect1_${id} select1_${id} 0 V={v(power_${id}) > .5 && ${drive:s0} > .5 && ${drive:s1} > .5 && ${drive:s2} > .5 && ${drive:s3} > .5 && ${drive:inh} > .5 && v(${pin:inh},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s0},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s1},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s2},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s3},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) ? 1 : 0}",
      "Aadc1_${id} [select1_${id}] [raw1_${id}] adc_${id}",
      "Adelay1_${id} raw1_${id} delayed1_${id} delay_${id}",
      "Adac1_${id} [delayed1_${id}] [state1_${id}] dac_${id}",
      "Vsense1_${id} ${pin:com0} contact1_${id} 0",
      "Bpath1_${id} contact1_${id} ${pin:ch0_1} I={v(contact1_${id},${pin:ch0_1})*(1/${param:roff}+(v(power_${id}) > .5 ? max(0,min(1,2*v(state1_${id})-1)) : 0)*(1/(v(${pin:vcc},${pin:gnd}) <= 4.5 ? ${param:ron_low} : v(${pin:vcc},${pin:gnd}) <= 6 ? ${param:ron_low}+(${param:ron_mid}-${param:ron_low})*(v(${pin:vcc},${pin:gnd})-4.5)/1.5 : v(${pin:vcc},${pin:gnd}) < 9 ? ${param:ron_mid}+(${param:ron_high}-${param:ron_mid})*(v(${pin:vcc},${pin:gnd})-6)/3 : ${param:ron_high})-1/${param:roff}))}",
      "Bselect2_${id} select2_${id} 0 V={v(power_${id}) > .5 && ${drive:s0} > .5 && ${drive:s1} > .5 && ${drive:s2} > .5 && ${drive:s3} > .5 && ${drive:inh} > .5 && v(${pin:inh},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s0},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s1},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s2},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s3},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) ? 1 : 0}",
      "Aadc2_${id} [select2_${id}] [raw2_${id}] adc_${id}",
      "Adelay2_${id} raw2_${id} delayed2_${id} delay_${id}",
      "Adac2_${id} [delayed2_${id}] [state2_${id}] dac_${id}",
      "Vsense2_${id} ${pin:com0} contact2_${id} 0",
      "Bpath2_${id} contact2_${id} ${pin:ch0_2} I={v(contact2_${id},${pin:ch0_2})*(1/${param:roff}+(v(power_${id}) > .5 ? max(0,min(1,2*v(state2_${id})-1)) : 0)*(1/(v(${pin:vcc},${pin:gnd}) <= 4.5 ? ${param:ron_low} : v(${pin:vcc},${pin:gnd}) <= 6 ? ${param:ron_low}+(${param:ron_mid}-${param:ron_low})*(v(${pin:vcc},${pin:gnd})-4.5)/1.5 : v(${pin:vcc},${pin:gnd}) < 9 ? ${param:ron_mid}+(${param:ron_high}-${param:ron_mid})*(v(${pin:vcc},${pin:gnd})-6)/3 : ${param:ron_high})-1/${param:roff}))}",
      "Bselect3_${id} select3_${id} 0 V={v(power_${id}) > .5 && ${drive:s0} > .5 && ${drive:s1} > .5 && ${drive:s2} > .5 && ${drive:s3} > .5 && ${drive:inh} > .5 && v(${pin:inh},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s0},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s1},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s2},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s3},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) ? 1 : 0}",
      "Aadc3_${id} [select3_${id}] [raw3_${id}] adc_${id}",
      "Adelay3_${id} raw3_${id} delayed3_${id} delay_${id}",
      "Adac3_${id} [delayed3_${id}] [state3_${id}] dac_${id}",
      "Vsense3_${id} ${pin:com0} contact3_${id} 0",
      "Bpath3_${id} contact3_${id} ${pin:ch0_3} I={v(contact3_${id},${pin:ch0_3})*(1/${param:roff}+(v(power_${id}) > .5 ? max(0,min(1,2*v(state3_${id})-1)) : 0)*(1/(v(${pin:vcc},${pin:gnd}) <= 4.5 ? ${param:ron_low} : v(${pin:vcc},${pin:gnd}) <= 6 ? ${param:ron_low}+(${param:ron_mid}-${param:ron_low})*(v(${pin:vcc},${pin:gnd})-4.5)/1.5 : v(${pin:vcc},${pin:gnd}) < 9 ? ${param:ron_mid}+(${param:ron_high}-${param:ron_mid})*(v(${pin:vcc},${pin:gnd})-6)/3 : ${param:ron_high})-1/${param:roff}))}",
      "Bselect4_${id} select4_${id} 0 V={v(power_${id}) > .5 && ${drive:s0} > .5 && ${drive:s1} > .5 && ${drive:s2} > .5 && ${drive:s3} > .5 && ${drive:inh} > .5 && v(${pin:inh},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s0},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s1},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s2},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s3},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) ? 1 : 0}",
      "Aadc4_${id} [select4_${id}] [raw4_${id}] adc_${id}",
      "Adelay4_${id} raw4_${id} delayed4_${id} delay_${id}",
      "Adac4_${id} [delayed4_${id}] [state4_${id}] dac_${id}",
      "Vsense4_${id} ${pin:com0} contact4_${id} 0",
      "Bpath4_${id} contact4_${id} ${pin:ch0_4} I={v(contact4_${id},${pin:ch0_4})*(1/${param:roff}+(v(power_${id}) > .5 ? max(0,min(1,2*v(state4_${id})-1)) : 0)*(1/(v(${pin:vcc},${pin:gnd}) <= 4.5 ? ${param:ron_low} : v(${pin:vcc},${pin:gnd}) <= 6 ? ${param:ron_low}+(${param:ron_mid}-${param:ron_low})*(v(${pin:vcc},${pin:gnd})-4.5)/1.5 : v(${pin:vcc},${pin:gnd}) < 9 ? ${param:ron_mid}+(${param:ron_high}-${param:ron_mid})*(v(${pin:vcc},${pin:gnd})-6)/3 : ${param:ron_high})-1/${param:roff}))}",
      "Bselect5_${id} select5_${id} 0 V={v(power_${id}) > .5 && ${drive:s0} > .5 && ${drive:s1} > .5 && ${drive:s2} > .5 && ${drive:s3} > .5 && ${drive:inh} > .5 && v(${pin:inh},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s0},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s1},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s2},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s3},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) ? 1 : 0}",
      "Aadc5_${id} [select5_${id}] [raw5_${id}] adc_${id}",
      "Adelay5_${id} raw5_${id} delayed5_${id} delay_${id}",
      "Adac5_${id} [delayed5_${id}] [state5_${id}] dac_${id}",
      "Vsense5_${id} ${pin:com0} contact5_${id} 0",
      "Bpath5_${id} contact5_${id} ${pin:ch0_5} I={v(contact5_${id},${pin:ch0_5})*(1/${param:roff}+(v(power_${id}) > .5 ? max(0,min(1,2*v(state5_${id})-1)) : 0)*(1/(v(${pin:vcc},${pin:gnd}) <= 4.5 ? ${param:ron_low} : v(${pin:vcc},${pin:gnd}) <= 6 ? ${param:ron_low}+(${param:ron_mid}-${param:ron_low})*(v(${pin:vcc},${pin:gnd})-4.5)/1.5 : v(${pin:vcc},${pin:gnd}) < 9 ? ${param:ron_mid}+(${param:ron_high}-${param:ron_mid})*(v(${pin:vcc},${pin:gnd})-6)/3 : ${param:ron_high})-1/${param:roff}))}",
      "Bselect6_${id} select6_${id} 0 V={v(power_${id}) > .5 && ${drive:s0} > .5 && ${drive:s1} > .5 && ${drive:s2} > .5 && ${drive:s3} > .5 && ${drive:inh} > .5 && v(${pin:inh},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s0},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) && v(${pin:s1},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s2},${pin:gnd}) >= ${param:vih}*v(${pin:vcc},${pin:gnd}) && v(${pin:s3},${pin:gnd}) <= ${param:vil}*v(${pin:vcc},${pin:gnd}) ? 1 : 0}",
      "Aadc6_${id} [select6_${id}] [raw6_${id}] adc_${id}",
      "Adelay6_${id} raw6_${id} delayed6_${id} delay_${id}",
      "Adac6_${id} [delayed6_${id}] [state6_${id}] dac_${id}",
