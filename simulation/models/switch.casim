{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "switch",
  "name": "Interactive SPST switch",
  "description": "Interactive two-terminal contact with configurable finite open/closed resistance. Push, reed and temperature symbols are operated manually; no bounce, field, temperature or automatic trip is simulated.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "p",
      "label": "Terminal 1",
      "role": "passive",
      "default_pin": "1"
    },
    {
      "id": "n",
      "label": "Terminal 2",
      "role": "passive",
      "default_pin": "2"
    }
  ],
  "parameters": [
    {
      "id": "on_resistance",
      "label": "Closed resistance",
      "default": "0.01",
      "unit": "Ohm",
      "min": 1e-09,
      "max": 1000000.0
    },
    {
      "id": "off_resistance",
      "label": "Open resistance",
      "default": "1e12",
      "unit": "Ohm",
      "min": 1,
      "max": 1000000000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Vcontrol${id} control${id} 0 ${control:initial}",
      "S${id} ${pin:p} ${pin:n} control${id} 0 m${id}"
    ],
    "definitions": [
      ".model m${id} SW(Ron=${param:on_resistance} Roff=${param:off_resistance} Vt=2.5 Vh=0.1)"
    ]
  },
  "matches": {
    "library_ids": [
      "Switch:SW_DIP_x01",
      "Switch:SW_Omron_B3FS",
      "Switch:SW_Push",
      "Switch:SW_Push_45deg",
      "Switch:SW_Push_Open",
      "Switch:SW_Reed",
      "Switch:SW_Reed_Opener",
      "Switch:SW_SPST",
      "Switch:SW_SPST_Temperature_NC",
      "Switch:SW_SPST_Temperature_NO"
    ],
    "symbol_names": [
      "SW_DIP_x01",
      "SW_Omron_B3FS",
      "SW_Push",
      "SW_Push_45deg",
      "SW_Push_Open",
      "SW_Reed",
      "SW_Reed_Opener",
      "SW_SPST",
      "SW_SPST_Temperature_NC",
      "SW_SPST_Temperature_NO"
    ]
  },
  "control": {
    "source": "Vcontrol${id}",
    "on": 5,
    "off": 0,
    "initially_open_symbols": [
      "SW_Push",
      "SW_Push_45deg",
      "SW_DIP_x01",
      "SW_Omron_B3FS",
      "SW_Reed",
      "SW_SPST_Temperature_NO"
    ]
  },
  "measurement_ports": {
    "positive": "p",
    "negative": "n"
  },
  "category": "Electromechanical/Switches",
  "family": "Interactive switches",
  "model_notes": [
    "Explicit reviewed symbol bindings; normally-closed Push_Open, Reed_Opener and temperature NC start closed. Existing SW_SPST initial state is preserved.",
    "Push buttons use the existing click-to-toggle interaction. Thermal/reed actuation is manual, without temperature or magnetic-field simulation."
  ]
}
