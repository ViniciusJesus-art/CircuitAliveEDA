{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "opamp_mcp6004",
  "name": "MCP6004 operational amplifier",
  "description": "Compact nominal 25 C behavior; see docs/circuitalive/ANALOG_MODEL_CATALOG.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "vp",
      "label": "Positive supply",
      "default_pin": "4",
      "role": "power"
    },
    {
      "id": "vn",
      "label": "Negative supply / reference",
      "default_pin": "11",
      "role": "reference"
    },
    {
      "id": "in1p",
      "label": "Input 1 +",
      "default_pin": "3",
      "role": "input"
    },
    {
      "id": "in1n",
      "label": "Input 1 -",
      "default_pin": "2",
      "role": "input"
    },
    {
      "id": "out1",
      "label": "Output 1",
      "default_pin": "1",
      "role": "output"
    },
    {
      "id": "in2p",
      "label": "Input 2 +",
      "default_pin": "5",
      "role": "input"
    },
    {
      "id": "in2n",
      "label": "Input 2 -",
      "default_pin": "6",
      "role": "input"
    },
    {
      "id": "out2",
      "label": "Output 2",
      "default_pin": "7",
      "role": "output"
    },
    {
      "id": "in3p",
      "label": "Input 3 +",
      "default_pin": "10",
      "role": "input"
    },
    {
      "id": "in3n",
      "label": "Input 3 -",
      "default_pin": "9",
      "role": "input"
    },
    {
      "id": "out3",
      "label": "Output 3",
      "default_pin": "8",
      "role": "output"
    },
    {
      "id": "in4p",
      "label": "Input 4 +",
      "default_pin": "12",
      "role": "input"
    },
    {
      "id": "in4n",
      "label": "Input 4 -",
      "default_pin": "13",
      "role": "input"
    },
    {
      "id": "out4",
      "label": "Output 4",
      "default_pin": "14",
      "role": "output"
    }
  ],
  "parameters": [
    {
      "id": "aol",
      "label": "Open-loop gain",
      "default": "398k",
      "unit": "",
      "min": 1,
      "max": 100000000.0
    },
    {
      "id": "gbw",
      "label": "Gain bandwidth product",
      "default": "1Meg",
      "unit": "Hz",
      "min": 1,
      "max": 10000000000.0
    },
    {
      "id": "slew",
      "label": "Slew rate",
      "default": "600k",
      "unit": "V/s",
      "min": 1,
      "max": 10000000000.0
    },
    {
      "id": "source_limit",
      "label": "Output source current limit per channel",
      "default": "23m",
      "unit": "A",
      "min": 1e-06,
      "max": 10
    },
    {
      "id": "sink_limit",
      "label": "Output sink current limit per channel",
      "default": "23m",
      "unit": "A",
      "min": 1e-06,
      "max": 10
    },
    {
      "id": "rout",
      "label": "Output stage resistance",
      "default": "40",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000.0
    },
    {
      "id": "high_drop",
      "label": "Upper output headroom",
      "default": ".025",
      "unit": "V",
      "min": 0,
      "max": 20
    },
    {
      "id": "low_drop",
      "label": "Lower output headroom",
      "default": ".025",
      "unit": "V",
      "min": 0,
      "max": 20
    },
    {
      "id": "vmin",
      "label": "Minimum supply difference",
      "default": "1.8",
      "unit": "V",
      "min": 0.1,
      "max": 100
    },
    {
      "id": "vmax",
      "label": "Maximum supply difference",
      "default": "6",
      "unit": "V",
      "min": 0.1,
      "max": 100
    },
    {
      "id": "offset",
      "label": "Input offset voltage",
      "default": "1m",
      "unit": "V",
      "min": -0.1,
      "max": 0.1
    },
    {
      "id": "bias",
      "label": "Input bias current; negative flows out",
      "default": "1p",
      "unit": "A",
      "min": -0.001,
      "max": 0.001
    },
    {
      "id": "rin",
      "label": "Differential input resistance",
      "default": "1e13",
      "unit": "Ohm",
      "min": 1,
      "max": 1000000000000000.0
    },
    {
      "id": "cin",
      "label": "Input capacitance",
      "default": "3p",
      "unit": "F",
      "min": 1e-15,
      "max": 1e-06
    },
    {
      "id": "cout",
      "label": "Output capacitance",
      "default": "20p",
      "unit": "F",
      "min": 1e-15,
      "max": 1e-06
    },
    {
      "id": "iq",
      "label": "Package quiescent current",
      "default": "0.0004",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "warning_current",
      "label": "Output current warning per channel",
      "default": "20m",
      "unit": "A",
      "min": 0,
      "max": 10
    }
  ],
  "matches": {
    "library_ids": [
      "Amplifier_Operational:MCP6004"
    ],
    "symbol_names": [
      "MCP6004"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "spice": {
    "instance": [
      "Bpower_${id} power_${id} 0 V={v(${pin:vp},${pin:vn}) >= ${param:vmin} && v(${pin:vp},${pin:vn}) <= ${param:vmax}}",
      "Biq_${id} ${pin:vp} ${pin:vn} I={v(power_${id}) > .5 ? ${param:iq} : 0}",
      "Rin1_${id} ${pin:in1p} ${pin:in1n} ${param:rin}",
      "Cin1p_${id} ${pin:in1p} ${pin:vn} ${param:cin}",
      "Cin1n_${id} ${pin:in1n} ${pin:vn} ${param:cin}",
      "Bib1p_${id} ${pin:in1p} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Bib1n_${id} ${pin:in1n} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Cdom1_${id} state1_${id} 0 1n ic=0",
      "Rdom1_${id} state1_${id} 0 {${param:aol}/(6.28318530718*${param:gbw}*1n)}",
      "Berror1_${id} 0 state1_${id} I={v(power_${id}) > .5 ? 1n*${param:slew}*tanh(6.28318530718*${param:gbw}*(v(${pin:in1p},${pin:in1n})+${param:offset})/${param:slew}) : 0}",
      "Bclamp1_${id} state1_${id} 0 I={max(0,v(state1_${id})-(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop})))-max(0,${param:low_drop}-v(state1_${id}))}",
      "Vout1_${id} ${pin:out1} out1_${id} 0",
      "Bsource1_${id} out1_${id} ${pin:vp} I={v(power_${id}) > .5 ? -max(0,(${param:source_limit}*v(current_scale_${id}))*tanh(((min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state1_${id}))))-v(out1_${id},${pin:vn}))/(${param:rout}*(${param:source_limit}*v(current_scale_${id}))))) : 0}",
      "Bsink1_${id} out1_${id} ${pin:vn} I={v(power_${id}) > .5 ? max(0,(${param:sink_limit}*v(current_scale_${id}))*tanh((v(out1_${id},${pin:vn})-(min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state1_${id})))))/(${param:rout}*(${param:sink_limit}*v(current_scale_${id}))))) : 0}",
      "Cout1_${id} out1_${id} ${pin:vn} ${param:cout}",
      "Roff1_${id} out1_${id} ${pin:vn} 1G",
      "Rin2_${id} ${pin:in2p} ${pin:in2n} ${param:rin}",
      "Cin2p_${id} ${pin:in2p} ${pin:vn} ${param:cin}",
      "Cin2n_${id} ${pin:in2n} ${pin:vn} ${param:cin}",
      "Bib2p_${id} ${pin:in2p} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Bib2n_${id} ${pin:in2n} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Cdom2_${id} state2_${id} 0 1n ic=0",
      "Rdom2_${id} state2_${id} 0 {${param:aol}/(6.28318530718*${param:gbw}*1n)}",
      "Berror2_${id} 0 state2_${id} I={v(power_${id}) > .5 ? 1n*${param:slew}*tanh(6.28318530718*${param:gbw}*(v(${pin:in2p},${pin:in2n})+${param:offset})/${param:slew}) : 0}",
      "Bclamp2_${id} state2_${id} 0 I={max(0,v(state2_${id})-(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop})))-max(0,${param:low_drop}-v(state2_${id}))}",
      "Vout2_${id} ${pin:out2} out2_${id} 0",
      "Bsource2_${id} out2_${id} ${pin:vp} I={v(power_${id}) > .5 ? -max(0,(${param:source_limit}*v(current_scale_${id}))*tanh(((min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state2_${id}))))-v(out2_${id},${pin:vn}))/(${param:rout}*(${param:source_limit}*v(current_scale_${id}))))) : 0}",
      "Bsink2_${id} out2_${id} ${pin:vn} I={v(power_${id}) > .5 ? max(0,(${param:sink_limit}*v(current_scale_${id}))*tanh((v(out2_${id},${pin:vn})-(min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state2_${id})))))/(${param:rout}*(${param:sink_limit}*v(current_scale_${id}))))) : 0}",
      "Cout2_${id} out2_${id} ${pin:vn} ${param:cout}",
      "Roff2_${id} out2_${id} ${pin:vn} 1G",
      "Rin3_${id} ${pin:in3p} ${pin:in3n} ${param:rin}",
      "Cin3p_${id} ${pin:in3p} ${pin:vn} ${param:cin}",
      "Cin3n_${id} ${pin:in3n} ${pin:vn} ${param:cin}",
      "Bib3p_${id} ${pin:in3p} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Bib3n_${id} ${pin:in3n} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Cdom3_${id} state3_${id} 0 1n ic=0",
      "Rdom3_${id} state3_${id} 0 {${param:aol}/(6.28318530718*${param:gbw}*1n)}",
      "Berror3_${id} 0 state3_${id} I={v(power_${id}) > .5 ? 1n*${param:slew}*tanh(6.28318530718*${param:gbw}*(v(${pin:in3p},${pin:in3n})+${param:offset})/${param:slew}) : 0}",
      "Bclamp3_${id} state3_${id} 0 I={max(0,v(state3_${id})-(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop})))-max(0,${param:low_drop}-v(state3_${id}))}",
      "Vout3_${id} ${pin:out3} out3_${id} 0",
      "Bsource3_${id} out3_${id} ${pin:vp} I={v(power_${id}) > .5 ? -max(0,(${param:source_limit}*v(current_scale_${id}))*tanh(((min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state3_${id}))))-v(out3_${id},${pin:vn}))/(${param:rout}*(${param:source_limit}*v(current_scale_${id}))))) : 0}",
      "Bsink3_${id} out3_${id} ${pin:vn} I={v(power_${id}) > .5 ? max(0,(${param:sink_limit}*v(current_scale_${id}))*tanh((v(out3_${id},${pin:vn})-(min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state3_${id})))))/(${param:rout}*(${param:sink_limit}*v(current_scale_${id}))))) : 0}",
      "Cout3_${id} out3_${id} ${pin:vn} ${param:cout}",
      "Roff3_${id} out3_${id} ${pin:vn} 1G",
      "Rin4_${id} ${pin:in4p} ${pin:in4n} ${param:rin}",
      "Cin4p_${id} ${pin:in4p} ${pin:vn} ${param:cin}",
      "Cin4n_${id} ${pin:in4n} ${pin:vn} ${param:cin}",
      "Bib4p_${id} ${pin:in4p} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Bib4n_${id} ${pin:in4n} ${pin:vn} I={v(power_${id}) > .5 ? ${param:bias} : 0}",
      "Cdom4_${id} state4_${id} 0 1n ic=0",
      "Rdom4_${id} state4_${id} 0 {${param:aol}/(6.28318530718*${param:gbw}*1n)}",
      "Berror4_${id} 0 state4_${id} I={v(power_${id}) > .5 ? 1n*${param:slew}*tanh(6.28318530718*${param:gbw}*(v(${pin:in4p},${pin:in4n})+${param:offset})/${param:slew}) : 0}",
      "Bclamp4_${id} state4_${id} 0 I={max(0,v(state4_${id})-(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop})))-max(0,${param:low_drop}-v(state4_${id}))}",
      "Vout4_${id} ${pin:out4} out4_${id} 0",
      "Bsource4_${id} out4_${id} ${pin:vp} I={v(power_${id}) > .5 ? -max(0,(${param:source_limit}*v(current_scale_${id}))*tanh(((min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state4_${id}))))-v(out4_${id},${pin:vn}))/(${param:rout}*(${param:source_limit}*v(current_scale_${id}))))) : 0}",
      "Bsink4_${id} out4_${id} ${pin:vn} I={v(power_${id}) > .5 ? max(0,(${param:sink_limit}*v(current_scale_${id}))*tanh((v(out4_${id},${pin:vn})-(min(max(${param:low_drop},v(${pin:vp},${pin:vn})-${param:high_drop}),max(${param:low_drop},v(state4_${id})))))/(${param:rout}*(${param:sink_limit}*v(current_scale_${id}))))) : 0}",
      "Cout4_${id} out4_${id} ${pin:vn} ${param:cout}",
      "Roff4_${id} out4_${id} ${pin:vn} 1G",
      "Bcurrent_scale_${id} current_scale_${id} 0 V={min(1,max(6/23,6/23+(v(${pin:vp},${pin:vn})-1.8)*(17/23)/3.7))}"
    ],
    "definitions": [
      ".options method=gear maxord=2"
    ]
  },
  "nominal_temperature_c": 25,
  "model_notes": [
    "Own compact model; manufacturer data supplies nominal parameters, not copied vendor SPICE code.",
    "No thermal drift, damage, production spread or exact noise/EMI/PSRR reproduction.",
    "Finite open-loop gain, one dominant pole/GBW, slew limit, output rail headroom and independent source/sink current limits per output.",
    "Compensation state is clamped to avoid unrealistically long saturation recovery; secondary poles, exact capacitive-load stability and input common-mode phase inversion are not reproduced.",
    "Use inputs inside the datasheet common-mode range; NULL pins have no physical trimming effect (use the offset parameter).",
    "Zero supply or a supply outside vmin/vmax leaves the output high impedance through a 1G leakage resistor.",
    "Requests circuit-wide Gear order 2 integration; no fixed small global maximum timestep.",
    "Source/sink limit parameters apply at 5.5V; a compact supply interpolation scales them to 6/23 at 1.8V. No temperature-dependent curves."
  ],
  "measurement_ports": {
    "positive": "vp",
    "negative": "vn"
  },
  "current_warning": {
    "signal": "max(max(max(abs(i(Vout1_${id})),abs(i(Vout2_${id}))),abs(i(Vout3_${id}))),abs(i(Vout4_${id})))",
    "limit_parameter": "warning_current"
  },
  "sources": [
    "https://ww1.microchip.com/downloads/en/DeviceDoc/MCP6001-1R-1U-2-4-1-MHz-Low-Power-Op-Amp-DS20001733L.pdf"
  ],
  "category": "Analog/Operational amplifiers",
  "family": "MCP600x"
}
