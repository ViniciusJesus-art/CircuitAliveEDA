{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "resistor",
  "name": "Ideal resistor",
  "description": "A resistive path between its two terminals. Resistance sets the current for a given voltage difference.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "p",
      "label": "Terminal 1",
      "role": "passive",
      "default_pin": "1"
    },
    {
      "id": "n",
      "label": "Terminal 2",
      "role": "passive",
      "default_pin": "2"
    }
  ],
  "parameters": [
    {
      "id": "resistance",
      "label": "Resistance",
      "default": "$value",
      "unit": "Ohm",
      "min": 1e-09,
      "max": 1000000000000000.0
    }
  ],
  "spice": {
    "instance": [
      "R${id} ${pin:p} ${pin:n} ${param:resistance}"
    ]
  },
  "matches": {
    "symbol_names": [
      "R",
      "R_45deg",
      "R_Small",
      "R_Small_US",
      "R_Trim",
      "R_US",
      "R_Variable",
      "R_Variable_US",
      "Thermistor",
      "Thermistor_NTC",
      "Thermistor_NTC_US",
      "Thermistor_PTC",
      "Thermistor_PTC_US",
      "Thermistor_US"
    ],
    "device_hints": [
      "R"
    ],
    "library_ids": [
      "Device:R",
      "Device:R_45deg",
      "Device:R_Small",
      "Device:R_Small_US",
      "Device:R_Trim",
      "Device:R_US",
      "Device:R_Variable",
      "Device:R_Variable_US",
      "Device:Thermistor",
      "Device:Thermistor_NTC",
      "Device:Thermistor_NTC_US",
      "Device:Thermistor_PTC",
      "Device:Thermistor_PTC_US",
      "Device:Thermistor_US"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "measurement_ports": {
    "positive": "p",
    "negative": "n"
  },
  "category": "Analog/Passive components",
  "family": "Resistors",
  "legacy_parameters": {
    "map": {
      "r": "resistance"
    },
    "only_if_value_invalid": true
  },
  "equations": [
    "I = (V1 − V2) / R."
  ],
  "model_notes": [
    "Trim/variable resistor symbols use the configured resistance; this is a two-terminal resistor, not a three-terminal potentiometer.",
    "Thermistors use their configured resistance at a fixed operating point. Temperature is outside the current scope; NTC/PTC curves and self-heating are not simulated."
  ]
}
