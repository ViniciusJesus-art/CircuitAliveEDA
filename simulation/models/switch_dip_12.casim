      "max": 1000000.0
    },
    {
      "id": "off_resistance",
      "label": "Open resistance",
      "default": "1e12",
      "unit": "Ohm",
      "min": 1,
      "max": 1000000000000000.0
    }
  ],
  "spice": {
    "instance": [
      "Vcontrol1_${id} control1_${id} 0 0",
      "Schannel1_${id} ${pin:terminal1} ${pin:terminal24} control1_${id} 0 m${id}",
      "Vcontrol2_${id} control2_${id} 0 0",
      "Schannel2_${id} ${pin:terminal2} ${pin:terminal23} control2_${id} 0 m${id}",
      "Vcontrol3_${id} control3_${id} 0 0",
