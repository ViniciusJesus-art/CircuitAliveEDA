{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74hc85",
  "name": "74HC85 4-bit magnitude comparator with cascade inputs",
  "description": "Nominal mixed-signal combinational logic; see docs/circuitalive/COMBINATIONAL_LOGIC_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "vcc",
      "label": "VCC",
      "role": "power",
      "default_pin": "16"
    },
    {
      "id": "gnd",
      "label": "GND",
      "role": "reference",
      "default_pin": "8"
    },
    {
      "id": "a0",
      "label": "A0",
      "role": "input",
      "default_pin": "10"
    },
    {
      "id": "b0",
      "label": "B0",
      "role": "input",
      "default_pin": "9"
    },
    {
      "id": "a1",
      "label": "A1",
      "role": "input",
      "default_pin": "12"
    },
    {
      "id": "b1",
      "label": "B1",
      "role": "input",
      "default_pin": "11"
    },
    {
      "id": "a2",
      "label": "A2",
      "role": "input",
      "default_pin": "13"
    },
    {
      "id": "b2",
      "label": "B2",
      "role": "input",
      "default_pin": "14"
    },
    {
      "id": "a3",
      "label": "A3",
      "role": "input",
      "default_pin": "15"
    },
    {
      "id": "b3",
      "label": "B3",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "ilt",
      "label": "ILT",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "ieq",
      "label": "IEQ",
      "role": "input",
      "default_pin": "3"
    },
    {
      "id": "igt",
      "label": "IGT",
      "role": "input",
      "default_pin": "4"
    },
    {
      "id": "ogt",
      "label": "OGT",
      "role": "output",
      "default_pin": "5"
    },
    {
      "id": "oeq",
      "label": "OEQ",
      "role": "output",
      "default_pin": "6"
    },
    {
      "id": "olt",
      "label": "OLT",
      "role": "output",
      "default_pin": "7"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Low input threshold / reference voltage",
      "default": ".3",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "High input threshold / reference voltage",
      "default": ".7",
      "unit": "",
      "min": 0.1,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Vmin",
      "default": "2",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "vmax",
      "label": "Vmax",
      "default": "6",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "rise_delay",
      "label": "Rise delay",
      "default": "10n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "fall_delay",
      "label": "Fall delay",
      "default": "10n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Transition",
      "default": "3n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Rout",
      "default": "45",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "cin",
      "label": "Cin",
      "default": "3.5p",
      "unit": "F",
      "min": 0,
      "max": 1
    },
    {
      "id": "iq",
      "label": "Iq",
      "default": "4u",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "high_drop",
      "label": "High drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    },
    {
      "id": "low_drop",
      "label": "Low drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    }
  ],
  "matches": {
    "library_ids": [
      "74xx:74HC85"
    ],
    "symbol_names": [
      "74HC85"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "xnor",
        "inputs": [
          "a0",
          "b0"
        ],
        "out": "eq0"
      },
      {
        "type": "xnor",
        "inputs": [
          "a1",
          "b1"
        ],
        "out": "eq1"
      },
      {
        "type": "xnor",
        "inputs": [
          "a2",
          "b2"
        ],
        "out": "eq2"
      },
      {
        "type": "xnor",
        "inputs": [
          "a3",
          "b3"
        ],
        "out": "eq3"
      },
      {
        "type": "and",
        "inputs": [
          "eq0",
          "eq1",
          "eq2",
          "eq3"
        ],
        "out": "equal"
      },
      {
        "type": "and",
        "inputs": [
          "a0",
          "!b0",
          "eq1",
          "eq2",
          "eq3"
        ],
        "out": "gt_term0"
      },
      {
        "type": "and",
        "inputs": [
          "a1",
          "!b1",
          "eq2",
          "eq3"
        ],
        "out": "gt_term1"
      },
      {
        "type": "and",
        "inputs": [
          "a2",
          "!b2",
          "eq3"
        ],
        "out": "gt_term2"
      },
      {
        "type": "and",
        "inputs": [
          "a3",
          "!b3"
        ],
        "out": "gt_term3"
      },
      {
        "type": "and",
        "inputs": [
          "equal",
          "!ieq",
          "!ilt"
        ],
        "out": "gt_cascade"
      },
      {
        "type": "or",
        "inputs": [
          "gt_term0",
          "gt_term1",
          "gt_term2",
          "gt_term3",
          "gt_cascade"
        ],
        "out": "gt"
      },
      {
        "type": "and",
        "inputs": [
          "!a0",
          "b0",
          "eq1",
          "eq2",
          "eq3"
        ],
        "out": "lt_term0"
      },
      {
        "type": "and",
        "inputs": [
          "!a1",
          "b1",
          "eq2",
          "eq3"
        ],
        "out": "lt_term1"
      },
      {
        "type": "and",
        "inputs": [
          "!a2",
          "b2",
          "eq3"
        ],
        "out": "lt_term2"
      },
      {
        "type": "and",
        "inputs": [
          "!a3",
          "b3"
        ],
        "out": "lt_term3"
      },
      {
        "type": "and",
        "inputs": [
          "equal",
          "!ieq",
          "!igt"
        ],
        "out": "lt_cascade"
      },
      {
        "type": "or",
        "inputs": [
          "lt_term0",
          "lt_term1",
          "lt_term2",
          "lt_term3",
          "lt_cascade"
        ],
        "out": "lt"
      },
      {
        "type": "and",
        "inputs": [
          "equal",
          "ieq"
        ],
        "out": "eq"
      }
    ],
    "outputs": {
      "ogt": {
        "signal": "gt"
      },
      "oeq": {
        "signal": "eq"
      },
      "olt": {
        "signal": "lt"
      }
    }
  },
  "sources": [
    "https://assets.nexperia.com/documents/data-sheet/74HC_HCT85.pdf"
  ],
  "category": "Digital/Comparators",
  "family": "74HC",
  "nominal_temperature_c": 25,
  "model_notes": [
    "Own event-driven circuit; no manufacturer SPICE source copied. Pin mappings and Boolean functions follow the referenced datasheet.",
    "Nominal 25 C approximation near 5 V. Propagation delay is per internal logic block, not a characterized package timing matrix. Different logic paths may have different total delays.",
    "Finite output resistance, input capacitance and fixed package quiescent current are represented. Output load affects voltage and settling.",
    "No DC input current/fan-out calibration, input clamps, back-powering, switching power, thermal effects or destructive failure. Output resistance does not implement a current limiter.",
    "Undriven inputs convert to X; outputs release outside the recommended supply window. Undefined logic states are weak analog midpoints, not a transistor-level metastability model.",
    "CMOS input thresholds scale with local VCC-GND. No Schmitt hysteresis is claimed.",
    "A3/B3 are the most significant bits. Cascade truth table includes all eight input combinations when A=B: IEQ HIGH dominates; all cascade inputs LOW asserts both greater/less outputs, while IGT=ILT=HIGH with IEQ LOW clears both."
  ],
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  }
}
