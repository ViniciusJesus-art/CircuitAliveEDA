{
  "schema_version": 2,
  "backend": "ngspice+runtime",
  "id": "mcu_atmega48p_a",
  "name": "ATmega48P-20A firmware",
  "description": "Firmware-driven AVR model. Load Intel HEX or BIN, choose clock and input sampling period. GPIO with finite drivers/pull-ups, timers, interrupts and ADC follow the emulated firmware. Supply and RESET are required. Fuses, oscillator circuitry, USB and precise supply consumption are not modeled.",
  "license": "GPL-3.0-or-later",
  "category": "Microcontrollers",
  "family": "AVR8",
