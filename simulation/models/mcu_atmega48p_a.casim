  "parameters": [
    {
      "id": "clock_hz",
      "label": "CPU clock",
      "unit": "Hz",
      "default": "16Meg",
      "min": 1000,
      "max": 20000000.0
    },
    {
      "id": "sample_period",
      "label": "Electrical input sampling period",
      "unit": "s",
      "default": "1u",
      "min": 1e-09,
      "max": 0.001
    }
  ],
  "resources": [
    {
      "id": "firmware",
      "label": "Firmware (Flash)",
      "kind": "firmware",
      "formats": [
        "ihex",
        "bin"
      ],
      "required": true,
      "max_bytes": 81920
    },
    {
      "id": "eeprom",
      "label": "Initial EEPROM image",
      "kind": "eeprom",
      "formats": [
        "ihex",
        "bin"
      ],
      "required": false,
      "max_bytes": 66560
    }
  ],
  "runtime": {
    "api_version": 1,
    "engine": "javascript",
    "device": "atmega48p",
    "modules": [
      "../runtime/avr8js.js"
    ],
    "clock_parameter": "clock_hz",
    "firmware_resource": "firmware",
    "firmware_bytes": 4096,
    "eeprom_resource": "eeprom",
    "eeprom_bytes": 256,
    "vcc": "vcc",
    "gnd": "gnd",
    "min_supply": 1.8,
    "max_supply": 5.5,
    "options": {
      "sramBytes": 512
    },
