{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "resistor_dividers_03",
  "name": "3-channel dual-terminator resistor network",
  "description": "Own compact electrical model. See docs/circuitalive/PASSIVE_BRIDGE_RELAY_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "upper",
      "label": "COM1",
      "default_pin": "1",
      "role": "passive"
    },
    {
      "id": "lower",
      "label": "COM2",
      "default_pin": "5",
      "role": "passive"
    },
    {
      "id": "tap1",
      "label": "Divider tap 1",
      "default_pin": "2",
      "role": "passive"
    },
    {
      "id": "tap2",
      "label": "Divider tap 2",
      "default_pin": "3",
      "role": "passive"
    },
    {
      "id": "tap3",
      "label": "Divider tap 3",
      "default_pin": "4",
      "role": "passive"
    }
  ],
  "parameters": [
    {
      "id": "upper_resistance",
      "label": "Resistance from COM1 to each tap",
      "default": "10k",
      "unit": "Ohm",
      "min": 1e-06,
      "max": 1000000000000.0
    },
    {
      "id": "lower_resistance",
      "label": "Resistance from each tap to COM2",
      "default": "10k",
      "unit": "Ohm",
      "min": 1e-06,
      "max": 1000000000000.0
    }
  ],
  "ignore_legacy_spice_fields": true,
  "matches": {
    "library_ids": [
      "Device:R_Network_Dividers_x03_SIP"
    ],
    "symbol_names": [
      "R_Network_Dividers_x03_SIP"
    ]
  },
  "spice": {
    "instance": [
      "Ru1_${id} ${pin:upper} ${pin:tap1} ${param:upper_resistance}",
      "Rl1_${id} ${pin:tap1} ${pin:lower} ${param:lower_resistance}",
      "Ru2_${id} ${pin:upper} ${pin:tap2} ${param:upper_resistance}",
      "Rl2_${id} ${pin:tap2} ${pin:lower} ${param:lower_resistance}",
      "Ru3_${id} ${pin:upper} ${pin:tap3} ${param:upper_resistance}",
      "Rl3_${id} ${pin:tap3} ${pin:lower} ${param:lower_resistance}"
    ],
    "definitions": []
  },
  "category": "Analog/Passive components",
  "family": "Resistor networks",
  "measurement_ports": {
    "positive": "upper",
    "negative": "lower"
  },
  "sources": [
    "https://www.vishay.com/docs/31509/csc.pdf",
    "https://www.vishay.com/docs/50064/dualterm.pdf"
  ],
  "model_notes": [
    "Independent divider taps between two shared buses; this is not a series resistor ladder.",
    "Configure upper_resistance and lower_resistance separately; defaults are 10 kohm each. Symbol Value is not used.",
    "Ideal resistors without production tolerance, thermal effects or damage. Displayed power uses COM1 current and COM1-COM2 voltage; external tap supplies may exchange additional power."
  ]
}
