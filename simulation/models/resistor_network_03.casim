{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "resistor_network_03",
  "name": "3-resistor bussed network",
  "description": "Own compact electrical model. See docs/circuitalive/PASSIVE_BRIDGE_RELAY_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "common",
      "label": "Common bus",
      "default_pin": "1",
      "role": "passive"
    },
    {
      "id": "leg1",
      "label": "Resistor 1",
      "default_pin": "2",
      "role": "passive"
    },
    {
      "id": "leg2",
      "label": "Resistor 2",
      "default_pin": "3",
      "role": "passive"
    },
    {
      "id": "leg3",
      "label": "Resistor 3",
      "default_pin": "4",
      "role": "passive"
    }
  ],
  "parameters": [
    {
      "id": "resistance",
      "label": "Resistance per branch",
      "default": "$value",
      "unit": "Ohm",
      "min": 1e-06,
      "max": 1000000000000.0
    }
  ],
  "ignore_legacy_spice_fields": true,
  "matches": {
    "library_ids": [
      "Device:R_Network03",
      "Device:R_Network03_Split",
      "Device:R_Network03_US"
    ],
    "symbol_names": [
      "R_Network03",
      "R_Network03_Split",
      "R_Network03_US"
    ]
  },
  "spice": {
    "instance": [
      "R1_${id} ${pin:common} ${pin:leg1} ${param:resistance}",
      "R2_${id} ${pin:common} ${pin:leg2} ${param:resistance}",
      "R3_${id} ${pin:common} ${pin:leg3} ${param:resistance}"
    ],
    "definitions": []
  },
  "category": "Analog/Passive components",
  "family": "Resistor networks",
  "measurement_ports": {
    "positive": "common",
    "negative": "leg1"
  },
  "sources": [
    "https://www.vishay.com/docs/31509/csc.pdf"
  ],
  "model_notes": [
    "Each resistor connects physical pin 1 to one separate leg, including the split-unit drawing.",
    "Value specifies each branch resistance, not the parallel equivalent. Ideal resistors; no tolerance, temperature drift, noise or thermal failure.",
    "Displayed current enters the common bus; voltage is common to leg 1, so displayed power is not total package dissipation under unequal leg voltages."
  ]
}
