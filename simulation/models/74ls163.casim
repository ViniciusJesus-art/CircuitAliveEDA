{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74ls163",
  "name": "74LS163 4-bit synchronous binary counter",
  "description": "Nominal mixed-signal logic with package pinout, propagation delay and finite output impedance. See docs/circuitalive/REGISTER_COUNTER_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "vcc",
      "label": "Positive supply",
      "role": "power",
      "default_pin": "16"
    },
    {
      "id": "gnd",
      "label": "Supply reference",
      "role": "reference",
      "default_pin": "8"
    },
    {
      "id": "mr",
      "label": "mr",
      "role": "input",
      "default_pin": "1"
    },
    {
      "id": "clk",
      "label": "clk",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "cep",
      "label": "cep",
      "role": "input",
      "default_pin": "7"
    },
    {
      "id": "pl",
      "label": "pl",
      "role": "input",
      "default_pin": "9"
    },
    {
      "id": "cet",
      "label": "cet",
      "role": "input",
      "default_pin": "10"
    },
    {
      "id": "tc",
      "label": "tc",
      "role": "output",
      "default_pin": "15"
    },
    {
      "id": "d0",
      "label": "d0",
      "role": "input",
      "default_pin": "3"
    },
    {
      "id": "d1",
      "label": "d1",
      "role": "input",
      "default_pin": "4"
    },
    {
      "id": "d2",
      "label": "d2",
      "role": "input",
      "default_pin": "5"
    },
    {
      "id": "d3",
      "label": "d3",
      "role": "input",
      "default_pin": "6"
    },
    {
      "id": "q0",
      "label": "q0",
      "role": "output",
      "default_pin": "14"
    },
    {
      "id": "q1",
      "label": "q1",
      "role": "output",
      "default_pin": "13"
    },
    {
      "id": "q2",
      "label": "q2",
      "role": "output",
      "default_pin": "12"
    },
    {
      "id": "q3",
      "label": "q3",
      "role": "output",
      "default_pin": "11"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Vil",
      "default": ".16",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "Vih",
      "default": ".4",
      "unit": "",
      "min": 0.1,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Vmin",
      "default": "4.75",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "vmax",
      "label": "Vmax",
      "default": "5.25",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "rise_delay",
      "label": "Rise delay",
      "default": "15n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "fall_delay",
      "label": "Fall delay",
      "default": "15n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Transition",
      "default": "2n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Rout",
      "default": "25",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "cin",
      "label": "Cin",
      "default": "3.5p",
      "unit": "F",
      "min": 0,
      "max": 1
    },
    {
      "id": "iq",
      "label": "Iq",
      "default": "19m",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "high_drop",
      "label": "High drop",
      "unit": "V",
      "default": "1.6",
      "min": 0,
      "max": 5
