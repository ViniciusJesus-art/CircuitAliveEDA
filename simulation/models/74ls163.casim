  "matches": {
    "library_ids": [
      "74xx:74LS163",
      "74xx_IEEE:74LS163"
    ],
    "symbol_names": [
      "74LS163"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "and",
        "inputs": [
          "cep",
          "cet"
        ],
        "out": "count_enabled"
      },
      {
        "type": "xor",
        "inputs": [
          "s0",
          "count_enabled"
        ],
        "out": "increment0"
      },
      {
        "type": "and",
        "inputs": [
          "pl",
          "increment0"
        ],
        "out": "count0"
      },
      {
        "type": "and",
        "inputs": [
          "!pl",
          "d0"
        ],
        "out": "load0"
      },
      {
        "type": "or",
        "inputs": [
          "count0",
          "load0"
        ],
        "out": "next0"
      },
      {
        "type": "and",
        "inputs": [
          "mr",
          "next0"
        ],
        "out": "cleared0"
      },
      {
        "type": "dff",
        "data": "cleared0",
        "clock": "clk",
        "set": "0",
        "reset": "0",
        "q": "s0",
        "nq": "n_s0",
        "initial": 2
      },
      {
        "type": "and",
        "inputs": [
          "count_enabled",
          "s0"
        ],
        "out": "toggle1"
      },
      {
        "type": "xor",
        "inputs": [
          "s1",
          "toggle1"
        ],
        "out": "increment1"
      },
      {
        "type": "and",
        "inputs": [
          "pl",
          "increment1"
        ],
        "out": "count1"
      },
      {
        "type": "and",
        "inputs": [
          "!pl",
          "d1"
        ],
        "out": "load1"
      },
      {
        "type": "or",
        "inputs": [
          "count1",
          "load1"
        ],
        "out": "next1"
      },
      {
        "type": "and",
        "inputs": [
          "mr",
          "next1"
        ],
        "out": "cleared1"
      },
      {
        "type": "dff",
        "data": "cleared1",
        "clock": "clk",
        "set": "0",
        "reset": "0",
        "q": "s1",
        "nq": "n_s1",
        "initial": 2
      },
      {
        "type": "and",
        "inputs": [
          "count_enabled",
          "s0",
          "s1"
        ],
        "out": "toggle2"
      },
      {
        "type": "xor",
        "inputs": [
          "s2",
          "toggle2"
        ],
        "out": "increment2"
      },
      {
        "type": "and",
        "inputs": [
          "pl",
          "increment2"
        ],
        "out": "count2"
      },
      {
        "type": "and",
        "inputs": [
          "!pl",
          "d2"
        ],
        "out": "load2"
      },
      {
        "type": "or",
        "inputs": [
          "count2",
          "load2"
        ],
        "out": "next2"
      },
      {
        "type": "and",
        "inputs": [
          "mr",
          "next2"
        ],
        "out": "cleared2"
      },
      {
        "type": "dff",
        "data": "cleared2",
        "clock": "clk",
        "set": "0",
        "reset": "0",
        "q": "s2",
        "nq": "n_s2",
        "initial": 2
      },
      {
        "type": "and",
        "inputs": [
          "count_enabled",
          "s0",
          "s1",
          "s2"
        ],
        "out": "toggle3"
      },
      {
        "type": "xor",
        "inputs": [
          "s3",
          "toggle3"
        ],
        "out": "increment3"
      },
      {
        "type": "and",
        "inputs": [
          "pl",
          "increment3"
        ],
        "out": "count3"
      },
      {
        "type": "and",
        "inputs": [
          "!pl",
          "d3"
        ],
        "out": "load3"
      },
      {
        "type": "or",
        "inputs": [
          "count3",
          "load3"
        ],
        "out": "next3"
      },
      {
        "type": "and",
        "inputs": [
          "mr",
          "next3"
        ],
        "out": "cleared3"
      },
      {
        "type": "dff",
        "data": "cleared3",
        "clock": "clk",
        "set": "0",
        "reset": "0",
        "q": "s3",
        "nq": "n_s3",
        "initial": 2
      },
      {
        "type": "and",
        "inputs": [
          "cet",
          "s0",
          "s1",
          "s2",
          "s3"
        ],
        "out": "terminal"
      }
    ],
    "outputs": {
      "q0": {
        "signal": "s0"
      },
      "q1": {
        "signal": "s1"
      },
      "q2": {
        "signal": "s2"
      },
      "q3": {
        "signal": "s3"
      },
      "tc": {
        "signal": "terminal"
      }
    },
    "clock_hysteresis": true
  },
  "sources": [
    "https://www.ti.com/lit/ds/symlink/sn74ls163a.pdf"
  ],
  "category": "Digital/Counters",
  "family": "74LS",
  "nominal_temperature_c": 25,
  "model_notes": [
    "Own event-driven functional model; no vendor SPICE source copied. The .casim file contains all device-specific behavior.",
    "Package pin numbers, control polarity, functional state and finite nominal delays are represented. Initial storage is unknown until reset, parallel load or enough valid clocks.",
    "Delays are per logic block, not a complete timing-characterization matrix. Allow settling and obey setup/hold; metastability and timing violations are not modeled.",
    "Input thresholds scale with local supply. LS/HCT/AHCT thresholds are calibrated to 0.8/2 V at 5 V; LS outputs approximate 3.4/0.2 V before loading.",
    "Finite output resistance, input capacitance and package quiescent current are fixed approximate nominal parameters. No detailed fan-out, TTL input current, ESD, parasitic power, thermal drift or damage.",
    "Outputs release outside the supply window. No retention through a power cycle is guaranteed.",
    "Physical clock inputs use supply-relative Schmitt action; data and other controls retain 0/X/1 conversion. All-input Schmitt behavior of AHC/AHCT is not reproduced.",
    "No fixed small global maximum timestep; XSPICE schedules internal events. Use circuit resolution appropriate to the electrical stimulus.",
    "PL LOW loads parallel inputs on the next rising clock, independently of CEP/CET. Otherwise both enables must be HIGH to count.",
    "TC = CET AND Q0 AND Q1 AND Q2 AND Q3. CEP does not gate TC.",
    "161 has active-low asynchronous MR. 163 has active-low synchronous MR; reset has priority over loading and enables.",
    "Combinational next-state gates add nominal delays. Cascade TC into CET and allow setup time before the shared clock."
  ]
}
