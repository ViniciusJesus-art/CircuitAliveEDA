      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "dff",
        "data": "d0",
        "clock": "clk",
        "set": "0",
        "reset": "!mr",
        "q": "s0",
        "nq": "n_s0",
        "initial": 2
      },
      {
        "type": "dff",
        "data": "d1",
        "clock": "clk",
        "set": "0",
        "reset": "!mr",
        "q": "s1",
        "nq": "n_s1",
        "initial": 2
      },
      {
        "type": "dff",
        "data": "d2",
        "clock": "clk",
        "set": "0",
        "reset": "!mr",
        "q": "s2",
        "nq": "n_s2",
        "initial": 2
      },
      {
        "type": "dff",
        "data": "d3",
        "clock": "clk",
        "set": "0",
        "reset": "!mr",
        "q": "s3",
        "nq": "n_s3",
        "initial": 2
      },
      {
        "type": "dff",
        "data": "d4",
        "clock": "clk",
        "set": "0",
        "reset": "!mr",
        "q": "s4",
        "nq": "n_s4",
        "initial": 2
      },
      {
        "type": "dff",
        "data": "d5",
