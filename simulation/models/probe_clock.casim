{
  "schema_version": 1,
  "backend": "ngspice",
  "license": "GPL-3.0-or-later",
  "category": "Sources/Debug probes",
  "family": "Ground-referenced stimulus probes",
  "pins": [
    {
      "id": "out",
      "label": "Output",
      "role": "output",
      "default_pin": "1"
    },
    {
      "id": "gnd",
      "label": "Internal GND",
      "role": "reference",
      "default_pin": "2"
    }
  ],
  "reference_pin": "gnd",
  "measurement_ports": {
    "positive": "out",
    "negative": "gnd"
  },
  "matches": {
    "library_ids": [],
    "symbol_names": []
  },
  "current_warning": {
    "signal": "i(Vsense${id})",
    "limit_parameter": "current_warning"
  },
  "id": "probe_clock",
  "name": "Clock stimulus probe",
  "description": "Ground-referenced clock generator with fixed 50% duty cycle, finite edges and output resistance.",
  "parameters": [
    {
      "id": "resistance",
      "label": "Output resistance",
      "default": "1",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "current_warning",
      "label": "Current warning (0 disables)",
      "default": "1",
      "unit": "A",
      "min": 0,
      "max": 1000000.0
    },
    {
      "id": "low",
      "label": "Low voltage",
      "default": "0",
      "unit": "V",
      "min": -1000000.0,
      "max": 1000000.0
    },
    {
      "id": "high",
      "label": "High voltage",
      "default": "5",
      "unit": "V",
      "min": -1000000.0,
      "max": 1000000.0
    },
    {
      "id": "frequency",
      "label": "Frequency",
      "default": "1000",
      "unit": "Hz",
      "min": 0.001,
      "max": 10000000.0
    },
    {
      "id": "delay",
      "label": "Start delay",
      "default": "0",
      "unit": "s",
      "min": 0,
      "max": 3600
    },
    {
      "id": "period",
      "label": "Period",
      "default": "0.001",
      "unit": "s",
      "min": 1e-07,
      "max": 1000
    },
    {
      "id": "rise",
      "label": "Rise time",
      "default": "1e-08",
      "unit": "s",
      "min": 1e-12,
      "max": 3600
    },
    {
      "id": "fall",
      "label": "Fall time",
      "default": "1e-08",
      "unit": "s",
      "min": 1e-12,
      "max": 3600
    }
  ],
  "frequency_parameter": "frequency",
  "spice": {
    "instance": [
      "Vwave${id} drive${id} ${pin:gnd} PULSE(${param:low} ${param:high} ${param:delay} ${param:rise} ${param:fall} {(${param:period}-${param:rise}-${param:fall})/2} ${param:period})",
      "Rout${id} drive${id} sense${id} ${param:resistance}",
      "Vsense${id} sense${id} ${pin:out} 0"
    ],
    "definitions": []
  }
}
