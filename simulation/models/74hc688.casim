{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74hc688",
  "name": "74HC688 8-bit equality comparator with active-low enable and result",
  "description": "Nominal mixed-signal combinational logic; see docs/circuitalive/COMBINATIONAL_LOGIC_MODELS.md.",
  "license": "GPL-3.0-or-later",
