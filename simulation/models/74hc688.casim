  "parameters": [
    {
      "id": "vil",
      "label": "Low input threshold / reference voltage",
      "default": ".3",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "High input threshold / reference voltage",
      "default": ".7",
      "unit": "",
      "min": 0.1,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Vmin",
      "default": "2",
      "unit": "V",
