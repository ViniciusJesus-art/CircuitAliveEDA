      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "high_drop",
      "label": "High drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    },
    {
      "id": "low_drop",
      "label": "Low drop",
      "unit": "V",
      "default": "0",
      "min": 0,
      "max": 5
    }
  ],
  "matches": {
    "library_ids": [
      "74xx:74HC688"
    ],
    "symbol_names": [
      "74HC688"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "xnor",
        "inputs": [
          "a0",
          "b0"
        ],
        "out": "eq0"
      },
      {
        "type": "xnor",
        "inputs": [
          "a1",
          "b1"
        ],
        "out": "eq1"
      },
      {
        "type": "xnor",
        "inputs": [
          "a2",
          "b2"
        ],
        "out": "eq2"
      },
      {
        "type": "xnor",
        "inputs": [
          "a3",
          "b3"
        ],
        "out": "eq3"
      },
      {
        "type": "xnor",
        "inputs": [
          "a4",
          "b4"
        ],
        "out": "eq4"
      },
      {
        "type": "xnor",
        "inputs": [
          "a5",
          "b5"
        ],
        "out": "eq5"
      },
      {
        "type": "xnor",
        "inputs": [
          "a6",
          "b6"
        ],
        "out": "eq6"
      },
      {
        "type": "xnor",
        "inputs": [
          "a7",
          "b7"
        ],
        "out": "eq7"
      },
      {
        "type": "nand",
        "inputs": [
          "!disable",
          "eq0",
          "eq1",
          "eq2",
          "eq3",
          "eq4",
          "eq5",
          "eq6",
          "eq7"
        ],
        "out": "result"
      }
    ],
    "outputs": {
      "neq": {
        "signal": "result"
      }
    }
  },
  "sources": [
    "https://www.ti.com/lit/ds/symlink/sn74hc688.pdf"
  ],
  "category": "Digital/Comparators",
  "family": "74HC",
  "nominal_temperature_c": 25,
  "model_notes": [
    "Own event-driven circuit; no manufacturer SPICE source copied. Pin mappings and Boolean functions follow the referenced datasheet.",
    "Nominal 25 C approximation near 5 V. Propagation delay is per internal logic block, not a characterized package timing matrix. Different logic paths may have different total delays.",
    "Finite output resistance, input capacitance and fixed package quiescent current are represented. Output load affects voltage and settling.",
    "No DC input current/fan-out calibration, input clamps, back-powering, switching power, thermal effects or destructive failure. Output resistance does not implement a current limiter.",
    "Undriven inputs convert to X; outputs release outside the recommended supply window. Undefined logic states are weak analog midpoints, not a transistor-level metastability model.",
    "CMOS input thresholds scale with local VCC-GND. No Schmitt hysteresis is claimed.",
    "Pin 19 is LOW only when both words match and pin 1 is LOW. Disabling forces HIGH; the result is a totem-pole output, not open collector or tri-state."
  ],
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  }
}
