{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "speaker",
  "name": "Loudspeaker",
  "description": "Loudspeaker",
  "license": "GPL-3.0-or-later",
  "category": "Simulation outputs",
  "family": "Functional peripherals",
  "pins": [
    {
      "id": "p",
      "label": "Positive",
      "role": "passive",
      "default_pin": "1"
    },
    {
      "id": "n",
      "label": "Negative",
      "role": "passive",
      "default_pin": "2"
    }
  ],
  "parameters": [
    {
      "id": "amplitude",
      "label": "Voltage for full audio scale",
      "default": "5",
      "min": 0.001,
      "max": 1000,
      "unit": "V"
    },
    {
      "id": "volume",
      "label": "Playback volume",
      "default": "0.2",
      "min": 0,
      "max": 1,
      "unit": ""
    },
    {
      "id": "resistance",
      "label": "Coil resistance",
      "default": "8",
      "min": 0.1,
      "max": 10000,
      "unit": "Ohm"
    },
    {
      "id": "inductance",
      "label": "Coil inductance",
      "default": "100u",
      "min": 1e-09,
      "max": 10,
      "unit": "H"
    }
  ],
  "spice": {
    "instance": [
      "Rcoil_${id} ${pin:p} coil_${id} ${param:resistance}",
      "Lcoil_${id} coil_${id} ${pin:n} ${param:inductance}",
      "Baudio_${id} audio_${id} 0 V={v(${pin:p},${pin:n})}"
    ],
    "definitions": []
  },
  "audio": {
    "signal": "v(audio_${id})",
    "full_scale": 5,
    "volume": 0.2,
    "full_scale_parameter": "amplitude",
    "volume_parameter": "volume"
  },
  "matches": {
    "library_ids": [
      "Device:Speaker"
    ]
  }
}
