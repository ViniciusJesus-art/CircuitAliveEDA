{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "74ahct1g125",
  "name": "74AHCT1G125 single buffer with 3-state output",
  "description": "Nominal powered small logic with finite output impedance; see docs/circuitalive/SMALL_LOGIC_MODELS.md.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "vcc",
      "label": "VCC",
      "role": "power",
      "default_pin": "5"
    },
    {
      "id": "gnd",
      "label": "GND",
      "role": "reference",
      "default_pin": "3"
    },
    {
      "id": "a1_0",
      "label": "Gate 1 input 1",
      "role": "input",
      "default_pin": "2"
    },
    {
      "id": "y1",
      "label": "Gate 1 output",
      "role": "output",
      "default_pin": "4"
    },
    {
      "id": "oe1",
      "label": "Gate 1 output enable",
      "role": "input",
      "default_pin": "1"
    }
  ],
  "parameters": [
    {
      "id": "vil",
      "label": "Low input threshold / reference voltage",
      "default": ".16",
      "unit": "",
      "min": 0,
      "max": 0.49
    },
    {
      "id": "vih",
      "label": "High input threshold / reference voltage",
      "default": ".4",
      "unit": "",
      "min": 0.1,
      "max": 1
    },
    {
      "id": "vmin",
      "label": "Minimum operating supply",
      "default": "4.5",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "vmax",
      "label": "Maximum operating supply",
      "default": "5.5",
      "unit": "V",
      "min": 0.1,
      "max": 20
    },
    {
      "id": "rise_delay",
      "label": "Nominal rising propagation delay",
      "default": "7n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "fall_delay",
      "label": "Nominal falling propagation delay",
      "default": "7n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "transition",
      "label": "Output transition time",
      "default": "1n",
      "unit": "s",
      "min": 1e-12,
      "max": 1
    },
    {
      "id": "rout",
      "label": "Nominal output resistance",
      "default": "35",
      "unit": "Ohm",
      "min": 0.01,
      "max": 1000000000.0
    },
    {
      "id": "cin",
      "label": "Input capacitance",
      "default": "2p",
      "unit": "F",
      "min": 0,
      "max": 1
    },
    {
      "id": "iq",
      "label": "Nominal quiescent supply current",
      "default": "2u",
      "unit": "A",
      "min": 0,
      "max": 1
    },
    {
      "id": "high_drop",
      "label": "Unloaded HIGH voltage drop",
      "default": "0",
      "unit": "V",
      "min": 0,
      "max": 5
    },
    {
      "id": "low_drop",
      "label": "Unloaded LOW voltage drop",
      "default": "0",
      "unit": "V",
      "min": 0,
      "max": 5
    },
    {
      "id": "threshold_reference",
      "label": "Absolute TTL threshold reference",
      "default": "5",
      "unit": "V",
      "min": 0.1,
      "max": 20
    }
  ],
  "matches": {
    "library_ids": [
      "74xGxx:74AHCT1G125"
    ],
    "symbol_names": [
      "74AHCT1G125"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "behavioral": {
    "version": 1,
    "supply": {
      "vcc": "vcc",
      "gnd": "gnd"
    },
    "blocks": [
      {
        "type": "buffer",
        "inputs": [
          "a1_0"
        ],
        "out": "q1"
      }
    ],
    "outputs": {
      "y1": {
        "signal": "q1",
        "enable": "!oe1"
      }
    },
    "electrical": {
      "threshold_reference": "threshold_reference"
    }
  },
  "sources": [
    "https://assets.nexperia.com/documents/data-sheet/74AHC_AHCT1G125.pdf"
  ],
  "model_notes": [
    "Own functional implementation from manufacturer truth tables and package pinouts; no vendor SPICE source copied.",
    "Only the explicitly named physical symbols are associated; connectors, graphic symbols and parts without an electrical function are not modeled.",
    "Fixed nominal propagation delay, resistance, input capacitance and quiescent current at room temperature; not calibrated across supply, temperature, package or load.",
    "No ESD, overvoltage clamps, input leakage, short-circuit limiting, thermal damage or back-powering model. The supply-valid gate releases outputs outside the declared operating range.",
    "See docs/circuitalive/SMALL_LOGIC_MODELS.md for physical channels, approximations, tests and source references."
  ],
  "measurement_ports": {
    "positive": "vcc",
    "negative": "gnd"
  },
  "category": "Digital/Small Logic",
  "family": "74AHCT"
}
