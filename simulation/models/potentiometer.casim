{
  "schema_version": 1,
  "backend": "ngspice",
  "id": "potentiometer",
  "name": "Potentiometer",
  "description": "Linear potentiometer with live wiper adjustment. Click the symbol during simulation to adjust its position.",
  "license": "GPL-3.0-or-later",
  "pins": [
    {
      "id": "top1",
      "label": "Top 1",
      "default_pin": "1",
      "role": "passive"
    },
    {
      "id": "wiper1",
      "label": "Wiper 1",
      "default_pin": "2",
      "role": "passive"
    },
    {
      "id": "bottom1",
      "label": "Bottom 1",
      "default_pin": "3",
      "role": "passive"
    }
  ],
  "parameters": [
    {
      "id": "resistance",
      "label": "Total resistance",
      "default": "$value",
      "unit": "Ohm",
      "min": 1e-06,
      "max": 1000000000000.0
    },
    {
      "id": "position",
      "label": "Wiper position (0 = bottom, 1 = top)",
      "default": ".5",
      "unit": "",
      "min": 0,
      "max": 1
    }
  ],
  "matches": {
    "library_ids": [
      "Device:R_Potentiometer",
      "Device:R_Potentiometer_Small",
      "Device:R_Potentiometer_Trim",
      "Device:R_Potentiometer_Trim_US",
      "Device:R_Potentiometer_US"
    ],
    "symbol_names": [
      "R_Potentiometer",
      "R_Potentiometer_Small",
      "R_Potentiometer_Trim",
      "R_Potentiometer_Trim_US",
      "R_Potentiometer_US"
    ]
  },
  "ignore_legacy_spice_fields": true,
  "spice": {
    "instance": [
      "Vposition_${id} position_${id} 0 ${param:position}",
      "Bupper1_${id} ${pin:top1} ${pin:wiper1} I={v(${pin:top1},${pin:wiper1})/max(1u,${param:resistance}*(1-min(1,max(0,v(position_${id})))) )}",
      "Blower1_${id} ${pin:wiper1} ${pin:bottom1} I={v(${pin:wiper1},${pin:bottom1})/max(1u,${param:resistance}*min(1,max(0,v(position_${id})))))}"
    ],
    "definitions": []
  },
  "nominal_temperature_c": 25,
  "model_notes": [
    "Own compact model; manufacturer data supplies nominal parameters, not copied vendor SPICE code.",
    "No thermal drift, damage, production spread or exact noise/EMI/PSRR reproduction.",
    "Linear taper, live position adjustable during simulation; initial position in Simulation model; uses the symbol Value as total resistance.",
    "Dual tracks share position while remaining electrically separate; mounting pins are isolated.",
    "No mechanical noise/wear or logarithmic taper; 1 microohm floor avoids zero-resistance singularities at endpoints."
  ],
  "measurement_ports": {
    "positive": "top1",
    "negative": "bottom1"
  },
  "electrical_groups": [
    [
      "top1",
      "wiper1",
      "bottom1"
    ]
  ],
  "sources": [
    "https://ngspice.sourceforge.io/docs/ngspice-manual.pdf"
  ],
  "adjustments": [
    {
      "id": "position",
      "label": "Wiper position",
      "source": "Vposition_${id}",
      "parameter": "position",
      "unit": "%",
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ],
  "category": "Analog/Passive components",
  "family": "Potentiometers and trimmers"
}
